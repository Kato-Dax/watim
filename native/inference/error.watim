import "../../std/maybe.watim" as Maybe (Maybe)
import "../../std/list.watim" as List (List)
import "../../std/arena.watim" as Arena (Arena)
import "../../std/array.watim" as Array (Array)
import "../../std/fmt.watim" as Fmt (Formatter)
import "../../std/byte-slice.watim" as ByteSlice (ByteSlice)
import "../../std/util.watim" as Util (i32-format)

import "../lexer.watim" as Lexer (Token)

import "../resolving/module.watim" as Resolved (Module)
import "../resolving/type-without-holes.watim" as Type (Type)
import "../resolving/pretty-type-without-holes.watim" as Type
import "../resolving/type-lookup.watim" as TypeLookup

import "./origin.watim" as Origin (Origin)

struct StringError {
    token: Token
    origin: List<Origin>
    expected: Type
}

struct NumberError {
    token: Token
    origin: List<Origin>
    expected: Type
}

struct CallError {
    token: Token
    return-index: i32
    expected: Type
    actual: Type
    origin: List<Origin>
}

struct GenericsContradict {
    generic: i32
    previous: Type
    now: Type
}

struct CallGenericContradictionError {
    token: Token
    return-index: i32
    expected: Type
    contradiction: GenericsContradict
}

struct LocalError {
    token: Token
    actual: Type
    expected: Type
    origin: List<Origin>
}

struct MatchParametersMismatchError {
    token: Token
    expected: Type
    parameter-index: i32
    origin: List<Origin>
    previously-inferred-parameters: Array<Maybe<Type>>
    previously-inferred-returns: Array<Maybe<Type>>
    origin-of-previously-inferred-parameters: Array<Maybe<List<Origin>>>
}

variant Error {
    case Deprecated -> DeprecatedError
    case String -> StringError
    case Number -> NumberError
    case Call -> CallError
    case CallGenericsContradict -> CallGenericContradictionError
    case Local -> LocalError
    case MatchParametersMismatch -> MatchParametersMismatchError
}
struct DeprecatedError {
    token: .Token
    msg-ptr: .i8
    msg-len: i32
}
fn error(token: .Token, msg-ptr: .i8, msg-len: i32) -> Error {
    $token $msg-ptr $msg-len make DeprecatedError make Error.Deprecated
}
fn error-with-origin(arena: .Arena, token: .Token, origin: .List<Origin>, msg-ptr: .i8, msg-len: i32) -> Error {
    $token $msg-ptr $msg-len
    // $arena $origin copy-origin
    error
}

fn display-origin(fmt: .Formatter, modules: .Array<Resolved:Module>, origin: .List<Origin>, file-path: ByteSlice) {
    $origin match {
        case List.Empty -> {}
        case List.Cons -> {
            drop
            $fmt "\n\n" Fmt:write
            $fmt Fmt:write-indent
            $fmt "The expected type originated from:" Fmt:write
            $fmt Fmt:indent
            $fmt $modules $origin $file-path display-origin-list
            $fmt Fmt:dedent
        }
    }
}

fn display-origin-list(fmt: .Formatter, modules: .Array<Resolved:Module>, origin: .List<Origin>, file-path: ByteSlice) {
    $origin loop (.List<Origin> ->) {
        match {
            case List.Empty -> { break }
            case List.Cons -> {}
        } @origin
        $fmt "\n" Fmt:write
        $fmt Fmt:write-indent
        $fmt $modules &origin.elem $file-path Origin:display
        $origin.next
    }
}

fn display(fmt: .Formatter, error: .Error, file-path: ByteSlice, modules: .Array<Resolved:Module>) {
    $modules TypeLookup:complete @lookup
    $error match {
        case Error.Deprecated ->{
            @error

            $fmt
            $file-path $error.token Lexer:Token-location make Lexer:TokenLocation &
            Lexer:format-location

            $fmt ": " Fmt:write
            $fmt $error.msg-ptr $error.msg-len Fmt:write
            $fmt "\n" Fmt:write
        }
        case Error.String -> {
            @error
            $fmt $file-path &error.token Lexer:Token-location make Lexer:TokenLocation & Lexer:format-location
            $fmt ": expected this word to return a value of type:\n" Fmt:write
            $fmt Fmt:indent $fmt Fmt:indent
            $fmt Fmt:write-indent
            $fmt &lookup &error.expected Type:pretty
            $fmt "\n" Fmt:write $fmt Fmt:dedent
            $fmt Fmt:write-indent
            $fmt "but it returns:\n" Fmt:write
            $fmt Fmt:indent $fmt Fmt:write-indent
            $fmt ".i8" Fmt:write
            $fmt Fmt:dedent
            $fmt $modules &error.origin $file-path display-origin
            $fmt Fmt:dedent
        }
        case Error.Number -> {
            @error
            $fmt $file-path &error.token Lexer:Token-location make Lexer:TokenLocation & Lexer:format-location
            $fmt ": expected this word to return a value of type:\n" Fmt:write
            $fmt Fmt:indent $fmt Fmt:indent
            $fmt Fmt:write-indent
            $fmt &lookup &error.expected Type:pretty
            $fmt "\n" Fmt:write $fmt Fmt:dedent
            $fmt Fmt:write-indent
            $fmt "but it returns:\n" Fmt:write
            $fmt Fmt:indent $fmt Fmt:write-indent
            $fmt "i32" Fmt:write
            $fmt Fmt:dedent
            $fmt $modules &error.origin $file-path display-origin
            $fmt Fmt:dedent
        }
        case Error.Call -> {
            @error
            $fmt $file-path &error.token Lexer:Token-location make Lexer:TokenLocation & Lexer:format-location
            $fmt ": expected the " Fmt:write
            $fmt $error.return-index 1 + i32-format
            $fmt ". return type of this call to be:\n" Fmt:write
            $fmt Fmt:indent $fmt Fmt:indent
            $fmt Fmt:write-indent
            $fmt &lookup &error.expected Type:pretty
            $fmt "\n" Fmt:write $fmt Fmt:dedent
            $fmt Fmt:write-indent
            $fmt "but it returns:\n" Fmt:write
            $fmt Fmt:indent $fmt Fmt:write-indent
            $fmt &lookup &error.actual Type:pretty
            $fmt Fmt:dedent
            $fmt $modules &error.origin $file-path display-origin
            $fmt Fmt:dedent
        }
        case Error.CallGenericsContradict -> {
            @error
            $fmt $file-path &error.token Lexer:Token-location make Lexer:TokenLocation & Lexer:format-location
            $fmt ": expected the " Fmt:write
            $fmt $error.return-index 1 + i32-format
            $fmt ". return type of this call to be:\n" Fmt:write
            $fmt Fmt:indent $fmt Fmt:indent
            $fmt Fmt:write-indent
            $fmt &lookup &error.expected Type:pretty
            $fmt "\n" Fmt:write $fmt Fmt:dedent
            $fmt Fmt:write-indent
            $fmt "but that would contradict previosly inferred generic arguments:\n" Fmt:write
            $fmt Fmt:indent $fmt Fmt:write-indent
            $fmt $error.contradiction.generic i32-format
            $fmt " " Fmt:write
            $fmt &lookup &error.contradiction.previous Type:pretty
            $fmt " vs " Fmt:write
            $fmt &lookup &error.contradiction.now Type:pretty
            $fmt Fmt:dedent
            // $fmt &error.origin $file-path display-origin
            $fmt Fmt:dedent
        }
        case Error.Local -> {
            @error
            $fmt $file-path &error.token Lexer:Token-location make Lexer:TokenLocation & Lexer:format-location
            $fmt ": expected this variable lookup to return:\n" Fmt:write
            $fmt Fmt:indent $fmt Fmt:indent
            $fmt Fmt:write-indent
            $fmt &lookup &error.expected Type:pretty
            $fmt "\n" Fmt:write $fmt Fmt:dedent
            $fmt Fmt:write-indent
            $fmt "but it actually returns:\n" Fmt:write
            $fmt Fmt:indent $fmt Fmt:write-indent
            $fmt &lookup &error.actual Type:pretty
            $fmt Fmt:dedent
            $fmt $modules &error.origin $file-path display-origin
            $fmt Fmt:dedent
        }
        case Error.MatchParametersMismatch -> {
            @error
            $fmt $file-path &error.token Lexer:Token-location make Lexer:TokenLocation & Lexer:format-location
            $fmt ": arms of match case have different types:\n" Fmt:write
            $fmt Fmt:indent
            $fmt Fmt:write-indent $fmt "previously inferred:\n" Fmt:write
            $fmt Fmt:indent
            $fmt Fmt:write-indent $fmt &lookup &error.previously-inferred-parameters Type:Types-pretty-bracketed-optional
            $fmt " -> " Fmt:write
            $fmt &lookup &error.previously-inferred-returns Type:Types-pretty-bracketed-optional
            $fmt "\n" Fmt:write
            $fmt Fmt:dedent
            $fmt Fmt:write-indent $fmt "expected:\n" Fmt:write
            $fmt Fmt:indent

            0 !.Arena Arena:temp @temp @save
            $temp &error.previously-inferred-parameters Array:clone @inferred-parameters-now
            &inferred-parameters-now $error.parameter-index $error.expected make Maybe.Some Array:set drop
            $fmt Fmt:write-indent $fmt &lookup &inferred-parameters-now Type:Types-pretty-bracketed-optional
            $fmt " -> " Fmt:write
            $fmt &lookup &error.previously-inferred-returns Type:Types-pretty-bracketed-optional
            $fmt Fmt:dedent
            $fmt $modules &error.origin $file-path display-origin
            &error.origin-of-previously-inferred-parameters $error.parameter-index Array:get match {
                case Maybe.None -> {}
                case Maybe.Some -> {
                    @origin
                    $fmt "\n\n" Fmt:write
                    $fmt Fmt:write-indent
                    $fmt "The previously inferred type originated from:" Fmt:write
                    $fmt Fmt:indent
                    $fmt $modules $origin $file-path display-origin-list
                    $fmt Fmt:dedent
                }
            }
            $fmt Fmt:dedent
        }
    }
}

