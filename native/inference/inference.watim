fn load<T>(ptr: .T) -> T { $ptr ~ }

fn copy-origin(arena: .Arena, list: .List<Origin>) -> Array<Origin> {
    $arena $list List:len Array:new-with-capacity @array
    $list loop {
        match {
            case List.Empty -> { break }
            case List.Cons -> {
                Core:dup
                .elem ~ &array flip Array:push-assert-no-alloc
                .next ~
            }
        }
    }
    $array
}

global EMPTY_ORIGIN: List<Origin>
fn empty-origin() -> .List<Origin> {
    List:empty #EMPTY_ORIGIN &EMPTY_ORIGIN
}
fn origin-singleton(ctx: .Ctx, origin: Origin) -> .List<Origin> {
    $ctx.temp $origin empty-origin List:cons Arena:push
}

fn infer-function(
    arena: .Arena,
    modules: .Array<Resolved:Module>,
    globals: .Array<Resolved:Global>,
    module-id: ModuleId,
    function: .Unstacked:Function,
    function-handle: FunctionHandle,
    log-level: LogLevel
) -> Result<Array<Function>, Error> {
    $arena Arena:temp @temp @save
    $temp &function.locals Map:clone @locals-of-function-and-all-closures
    0 loop {
        @i $i $function.closures.len = if { break }
        $temp
        &locals-of-function-and-all-closures
        &function.closures $i Array:get .locals
        Map:extend
        $i 1 +
    }

    Array:new @environment-types

    make Ctx {
        $arena @arena
        $temp @temp
        $log-level @log-level
        $arena 2 Fmt:to-fd "    " Fmt:use-indentation Arena:push<_> @fmt
        $modules @modules
        $modules TypeLookup:complete @type-lookup
        $module-id @module-id
        $function-handle @function-handle
        &locals-of-function-and-all-closures @locals
        $globals @globals
        &function.closures @closures
        &environment-types @environment-types
        $arena &function.holes Unstacked:Holes-clone @holes
        Array:new @origins
        \ptr-eq<Source> Map:new<.Source, InferenceState> @states
        &function.nodes @nodes
        Array:new<Maybe<i32>> @field-holes
        $arena make TokenTy.TOKEN_BOOL Token-new-synthetic make Type.Bool Arena:push<_> @type-bool
        $arena make TokenTy.TOKEN_I32  Token-new-synthetic make Type.I32  Arena:push<_> @type-i32
        \CustomTypeHandle-eq Map:new @custom-type-signatures
        Array:new @deferred
        1 @progress
        0 1 = @ignore-being-inferred
    } @ctx

    &ctx $ctx.function-handle fix-function-handle #ctx.function-handle

    $ctx.log-level match {
        case NoLogs -> {}
        case _ -> {
            drop
            $ctx.fmt "infer-function: " Fmt:write
            $ctx.fmt &function.name Token-format
            $ctx.fmt "\n" Fmt:write
            $ctx.fmt Fmt:indent
        }
    }

    block {
        0 loop {
            @i $i $function.locals.values.len = if { break }
            &function.locals.values $i Array:get<_> @local
            &local.parameter match {
                case None -> {}
                case Some -> {
                    @parameter
                    $parameter.index $parameter.type make Origin:FromParameter make Origin.FromParameter &ctx flip origin-singleton @origin
                    &ctx $local.type $parameter.type $origin make TypeWithOrigin & fill-hole-with-origin
                }
            }
            $i 1 +
        }

        &function.returns match {
            case None -> {}
            case Some -> {
                @returns

                $function.signature.returns.len $returns.len /= if {
                    $modules TypeLookup:complete @lookup
                    $arena Fmt:into-new-string @buf @fmt
                    &fmt "unexpected return values:" Fmt:write
                    &fmt "\n\texpected: " Fmt:write
                    &fmt &lookup &function.signature.returns Type:Types-pretty-bracketed
                    &fmt "\n\tactual:   [" Fmt:write
                    0 loop {
                        @i $i $returns.len = if { make Maybe<Error>.None break }
                        $returns $i Array:get<_>
                        &ctx flip infer match {
                            case InferenceResult.Error -> { make Maybe<Error>.Some break }
                            case InferenceResult.Success -> { .type & &fmt flip &lookup flip Type:pretty }
                            case Fail -> { &fmt "_" Fmt:write }
                        }
                        $i 1 + $returns.len /= if {
                            &fmt ", " Fmt:write
                        }
                        $i 1 +
                    } match {
                        case Some -> { make Result.Error break }
                        case None -> {}
                    }
                    &fmt "]" Fmt:write
                    &function.name $buf Array:unpack<_> error make Result.Error break
                }
            }
        }

        &function.returns match {
            case None -> {}
            case Some -> {
                @returns

                0 loop {
                    @i $i $returns.len = if {
                        unit make Result<Unit, Error>.Success break
                    }
                    $returns $i Array:get<_> @source

                    make TypeWithOrigin {
                        &function.signature.returns $i Array:get<_> @return-type
                        $ctx.temp $i $return-type ~ make Origin:FromReturn make Origin.FromReturn $ctx.temp List:empty Arena:push List:cons Arena:push @origin
                        $return-type ~ @type
                    } @expected

                    &ctx $source &expected check match {
                        case None -> {}
                        case Some -> { make Result<Unit, Error>.Error break }
                    }

                    $i 1 +
                } match {
                    case Error -> { make Result.Error break }
                    case Success -> { useless }
                }
            }
        }

        0 loop (i32 ->) {
            @i $i $function.voids.len = if { break }
            $ctx.temp &ctx.deferred &function.voids $i Array:get<_> make DeferredInfer.StackVoid $ctx.progress make DeferredInferAtProgress make DeferredItem.DeferredInfer Array:push<_>
            $i 1 +
        }

        $ctx.progress 1 + #ctx.progress

        loop (-> Maybe<Error>) {
            $ctx.deferred.len 0 = if { make Maybe<Error>.None break }
            &ctx.deferred Array:pop-front @deferred
            $deferred match {
                case DeferredCheck -> {
                    @deferred
                    $deferred.progress $ctx.progress = if {
                        $ctx.fmt $deferred.source Source-format
                        $ctx.arena $deferred.source Source-token $deferred.known.origin "failed to check item" error-with-origin make Maybe<Error>.Some break
                    }
                    &ctx $deferred.source &deferred.known check match {
                        case None -> {}
                        case _ -> { break }
                    }
                }
                case DeferredInfer -> {
                    @deferred
                    $deferred.deferred match {
                        case DeferredInfer.StackVoid -> {}
                    } @void

                    $deferred.progress $ctx.progress = if {
                        $void match {
                            case StackVoid.NonSpecific -> { .token }
                            case StackVoid.Store -> { .token }
                            case StackVoid.IndirectCall -> { .token }
                            case StackVoid.Call -> { .token }
                            case StackVoid.ImpossibleMatch -> { .token }
                            case StackVoid.SetGlobal -> { .token }
                        }
                        "failed to infer type of void" error make Maybe<Error>.Some break
                    }

                    &ctx $void infer-stack-void match {
                        case None -> {}
                        case _ -> { break }
                    }
                }
            }
        } match {
            case None -> {}
            case Some -> { make Result.Error break }
        }

        0 loop {
            @i $i $function.locals.values.len = if { make Maybe<Error>.None break }
            &function.locals.values $i Array:get<_> @local

            &ctx $local.type lookup-type-with-origin match {
                case Some -> {}
                case None -> {
                    &ctx $local infer-local match {
                        case InferenceResult.Error -> { make Maybe<Error>.Some break }
                        case InferenceResult.Success -> {}
                        case InferenceResult.Fail -> {
                            &local.name Name-token
                            "StackVoid.SetLocal failed to infer type of local" error make Maybe<Error>.Some break
                        }
                    }
                }
            } @local-type

            &ctx $local make TypeWithOrigin {
                $local-type.type @type
                $ctx.temp &local.name Name-token ~ $local-type.type make Origin:FromLocal make Origin.FromLocal $local-type.origin List:cons Arena:push @origin
            } & check-local-assignments match {
                case None -> {}
                case _ -> { break }
            }

            $i 1 +
        } match {
            case None -> {}
            case Some -> { make Result.Error break }
        }

        $ctx.arena $function.closures.len 1 + Array:new-with-capacity @functions

        $ctx.arena &function.signature.generic-parameters generic-types-from-generic-parameters @pass-through-generic-arguments

        $ctx.modules $module-id.index Array:get<_> .type-definitions Core:dup $ctx.arena flip Map:clone store

        $function.closures.len loop {
            @i $i 0 = if { make Maybe<Error>.None break }
            $i 1 - @closure-index
            &function.closures $closure-index Array:get @closure

            Array:new @environment-fields
            0 loop {
                @i $i $closure.captured.len = if { break }
                &closure.captured $i Array:get @captured-local-id
                &locals-of-function-and-all-closures $captured-local-id Map:get Maybe:assert-some @captured-local

                &ctx $captured-local.type lookup-hole Maybe:assert-some make Type.Ptr
                $captured-local.name flip make NamedType
                $ctx.arena flip &environment-fields flip Array:push
                $i 1 +
            }

            make Struct {
                $closure.token @name
                $closure.generic-parameters @generic-parameters
                $environment-fields @fields
            } make TypeDefinition.Struct @environment-struct

            $module-id $ctx.modules $module-id.index Array:get<_> .type-definitions.values.len ~ make CustomTypeHandle @environment-struct-handle
            make Type:CustomTypeType {
                $closure.token @token
                $environment-struct-handle @type-definition
                $ctx.arena &closure.generic-parameters generic-types-from-generic-parameters @generic-arguments
            } @environment-struct-type

            $ctx.arena $ctx.environment-types make Maybe.None $closure-index $environment-struct-type make Maybe.Some Array:extending-set

            $ctx.arena $ctx.modules $module-id.index Array:get<_> .type-definitions.values $environment-struct Array:push

            &closure.locals &closure.environment-local Map:get Maybe:assert-some @environment-local
            &ctx make Origin.TODO origin-singleton @origin
            &ctx $environment-local.type $environment-struct-type make Type.Custom & make Type.Ptr $origin make TypeWithOrigin & fill-hole-with-origin

            $i 1 -
        } match {
            case None -> {}
            case Some -> { make Result.Error break }
        }

        &ctx &function.body fill-holes-scope @body
        &functions make Function {
            $function.name make Name.User @name
            $function.export @export
            $function.signature @signature
            &ctx &function.locals fill-holes-locals @locals
            $body @body
        } Array:push-assert-no-alloc

        $function.closures.len loop {
            @i $i 0 = if { break }
            $i 1 - @closure-index
            &function.closures $closure-index Array:get @closure

            &ctx &closure.parameters fill-holes @parameter-types

            $function.name $closure.token $closure-index make AnonymousFunctionName make Name.AnonymousFunction @closure-name

            Array:new @parameters
            0 loop {
                @i $i $parameter-types.len = if { break }
                $ctx.arena &parameters make Parameter {
                    $closure.token make Name.ClosureParam @name
                    &parameter-types $i Array:get ~ @type
                    $i @index
                } Array:push
                $i 1 +
            }

            &ctx &closure.locals fill-holes-locals @locals
            &locals &closure.environment-local Map:get Maybe:assert-some @environment-local
            make Parameter {
                $parameters.len @index
                $closure-name @name
                $environment-local.type @type
            } @environment-parameter
            $ctx.arena &parameters $environment-parameter Array:push

            make FunctionSignature {
                $closure.generic-parameters @generic-parameters
                $parameters @parameters
                &ctx &closure.returns fill-holes @returns
            } @signature

            $environment-parameter.index make Maybe.Some #environment-local.parameter-index

            &functions make Function {
                $closure-name @name
                make Maybe.None @export
                $signature @signature
                $closure.environment-local @environment-local
                $locals @locals
                &ctx &closure.body fill-holes-scope @body
            } Array:push-assert-no-alloc

            $i 1 -
        }

        &functions $functions.len $function.closures.len - $functions.len 1 - Array:slice & Array:reverse

        $functions make Result.Success
    }
    $temp $save Arena:restore
    &ctx logging if { $ctx.fmt Fmt:dedent }
}

fn infer-stack-void(ctx: .Ctx, void: .StackVoid) -> Maybe<Error> {
    block {
        $ctx logging if {
            $ctx.fmt Fmt:write-indent
            $ctx.fmt "> infer void: " Fmt:write
            $ctx.fmt $void $ctx full-sources if {
                Unstacked:StackVoid-format
            } else {
                Unstacked:StackVoid-format-shallow
            }
            $ctx.fmt "\n" Fmt:write
            $ctx.fmt Fmt:indent
        }

        make Origin.TODO List:empty & List:cons @todo-origin

        $void match {
            case StackVoid.NonSpecific -> {
                @void
                &void.source match {
                    case None -> {
                        Core:unreachable<.Source>
                    }
                    case Some -> {}
                } @source
                &void.known match {
                    case None -> {
                        $ctx $source infer match {
                            case InferenceResult.Error -> { make Maybe<Error>.Some break }
                            case InferenceResult.Success -> { make Maybe.Some }
                            case InferenceResult.Fail -> { make Maybe.None }
                        }
                    }
                    case Some -> {
                        @known
                        $ctx $source $known check match {
                            case None -> {}
                            case _ -> { break }
                        }
                        $known ~ make Maybe.Some
                    }
                } match {
                    case None -> { 1 1 = }
                    case Some -> {
                        $void.type match {
                            case None -> { drop }
                            case Some -> { @hole $ctx flip $hole flip & fill-hole-with-origin }
                        }
                        0 1 =
                    }
                }
            }
            case StackVoid.Store -> {
                @void
                &void.dst match {
                    case None -> {
                        &void.token "dst missing" error make Maybe<Error>.Some break
                    }
                    case Some -> {}
                } @dst
                &void.src match {
                    case None -> {
                        &void.token "src missing" error make Maybe<Error>.Some break
                    }
                    case Some -> {}
                } @src

                $ctx $dst infer match {
                    case InferenceResult.Error -> { make Maybe<Error>.Some break }
                    case InferenceResult.Fail -> {
                        $ctx $src infer match {
                            case InferenceResult.Error -> { make Maybe<Error>.Some break }
                            case InferenceResult.Success -> {}
                            case InferenceResult.Fail -> {
                                &void.token "failed to infer type of store" error make Maybe<Error>.Some break
                            }
                        } @src
                        // TODO: add item to origin for this store, something like make Origin.FromLoad
                        $ctx $dst &src.type make Type.Ptr $src.origin make TypeWithOrigin & check match {
                            case None -> {}
                            case _ -> { break }
                        } $src
                    }
                    case InferenceResult.Success -> {
                        @dst
                        $dst.type match {
                            case Type.Ptr -> {}
                            case _ -> {
                                drop &void.token "cannot store into non-ptr" error make Maybe<Error>.Some break
                            }
                        } @dst-child-type
                        // TODO: add item to origin for this store, something like make Origin.FromLoad
                        $ctx $src $dst-child-type ~ $dst.origin make TypeWithOrigin & check match {
                            case None -> {}
                            case _ -> { break }
                        } $dst
                    }
                } @type
                $ctx $void.type $type & fill-hole-with-origin
                0 1 =
            }
            case StackVoid.IndirectCall -> {
                @void
                &void.function match {
                    case None -> { &void.token "expected function on stack" error make Maybe<Error>.Some break }
                    case Some -> {}
                } @function
                $ctx &void.parameters lookup-holes match {
                    case None -> { 1 1 = }
                    case Some -> {
                        @parameters
                        $ctx &void.returns lookup-holes match {
                            case None -> { 1 1 = }
                            case Some -> {
                                @returns

                                $void.token $parameters $returns make Type:FunType
                                $void.closure if { make Type.Closure } else { make Type.Fun } @known
                                $void.token $known make Origin:FromAnnotation make Origin.FromAnnotation
                                $ctx.temp List:empty Arena:push List:cons
                                $ctx.temp flip Arena:push @origin
                                $known $origin make TypeWithOrigin @known
                                $ctx $void.function-type &known fill-hole-with-origin
                                $ctx $function &known check match {
                                    case None -> { 0 1 = }
                                    case _ -> { break }
                                }
                            }
                        }
                    }
                }
            }
            case StackVoid.SetGlobal -> {
                @void
                $ctx $void.global-type &todo-origin make TypeWithOrigin & &void.fields traverse-fields match {
                    case Success -> {}
                    case Error -> { make Maybe<Error>.Some break }
                } @known

                &void.source match {
                    case None -> { &void.token "set global expected item" error make Maybe<Error>.Some break }
                    case Some -> {}
                } @source

                $ctx $void.type &known fill-hole-with-origin
                $ctx $source &known check match {
                    case None -> {}
                    case _ -> { break }
                }
                0 1 =
            }
            case StackVoid.Call -> {
                @void
                $ctx $void.function lookup-signature @signature
                $ctx &void.arguments infer-over-array match {
                    case Error -> { make Maybe<Error>.Some break }
                    case Success -> {}
                } @argument-types
                $void.arguments.len $signature Signature-parameters-len /= if {
                    $ctx &void.token $signature &void.generic-arguments &argument-types
                    call-argument-mismatch-error make Maybe<Error>.Some break
                }
                1 1 = 0 loop (bool, i32 -> Result<bool, Error>) {
                    @i $i $signature Signature-parameters-len = if {
                        make Result<bool, Error>.Success break
                    }
                    $signature $i Unstacked:Signature-parameter @expected
                    $expected Type:contains-generic not if {
                        &argument-types $i Array:get<_> match {
                            case None -> {
                                $ctx
                                &void.arguments $i Array:get<_>
                                make TypeWithOrigin {
                                    $expected ~ @type
                                    $ctx.temp $i $expected ~ make Origin:FromParameter make Origin.FromParameter $ctx.temp List:empty Arena:push List:cons Arena:push @origin
                                } & check match {
                                    case None -> {}
                                    case Some -> { make Result<bool, Error>.Error break }
                                }
                            }
                            case Some -> {
                                .type $expected Type:eq not if {
                                    $ctx &void.token $signature &void.generic-arguments &argument-types
                                    call-argument-mismatch-error make Result<bool, Error>.Error break
                                }
                            }
                        }
                    } else {
                        drop
                        &argument-types $i Array:get<_> match {
                            case None -> {}
                            case Some -> {
                                @argument-type
                                $ctx &void.generic-arguments $expected $argument-type unify-types match {
                                    case UnificationResult.Success -> {}
                                    case _ -> {
                                        drop $ctx &void.token $signature &void.generic-arguments &argument-types
                                        call-argument-mismatch-error make Result<bool, Error>.Error break
                                    }
                                }
                            }
                        }
                        0 1 =
                    }
                    $i 1 +
                } match {
                    case Success -> {}
                    case Error -> { make Maybe<Error>.Some break }
                } @there-are-no-generic-parameters

                $there-are-no-generic-parameters not if {
                    $ctx &void.generic-arguments lookup-holes match {
                        case Some -> {
                            @generic-arguments
                            // The generic-arguments are known, use them to monomorphise the parameters
                            // and then check the arguments those parameters.
                            // TODO
                            0 loop {
                                @i $i $signature Signature-parameters-len = if { make Maybe<Error>.None break }
                                $ctx.arena
                                $signature $i Unstacked:Signature-parameter
                                &generic-arguments Type:with-generics @parameter
                                &argument-types $i Array:get<_> match {
                                    case None -> {
                                        $ctx &void.arguments $i Array:get<_> make TypeWithOrigin {
                                            $parameter @type
                                            $ctx.temp $i $parameter make Origin:FromParameter make Origin.FromParameter $ctx.temp List:empty Arena:push List:cons Arena:push @origin
                                        } & check match {
                                            case None -> {}
                                            case _ -> { break }
                                        }
                                    }
                                    case Some -> {
                                        .type &parameter Type:eq not if {
                                            $ctx &void.token $signature &void.generic-arguments &argument-types
                                            call-argument-mismatch-error make Maybe<Error>.Some break
                                        }
                                    }
                                }
                                $i 1 +
                            } match {
                                case None -> {}
                                case _ -> { break }
                            }
                        }
                        case None -> {
                            0 loop (i32 -> Maybe<Error>) {
                                @i $i $signature Signature-parameters-len = if { make Maybe<Error>.None break }
                                $ctx
                                &void.generic-arguments
                                $signature $i Unstacked:Signature-parameter
                                &argument-types $i Array:get<_> match {
                                    case None -> { &void.token "failed to infer argument" error make Maybe<Error>.Some break }
                                    case Some -> {}
                                } unify-types match {
                                    case UnificationResult.Success -> {}
                                    case _ -> {
                                        drop $ctx &void.token $signature &void.generic-arguments &argument-types
                                        call-argument-mismatch-error make Maybe<Error>.Some break
                                    }
                                }
                                $i 1 +
                            } match {
                                case None -> {}
                                case _ -> { break }
                            }
                        }
                    }
                }
                0 1 =
            }
            case StackVoid.ImpossibleMatch -> {
                @void
                &void.source match {
                    case None -> { &void.token "match expected value" error make Maybe<Error>.Some break }
                    case Some -> {}
                } @source
                $ctx $source infer match {
                    case InferenceResult.Error -> { make Maybe<Error>.Some break }
                    case InferenceResult.Success -> {}
                    case InferenceResult.Fail -> {
                        &void.token "failed to infer type of scrutinee" error make Maybe<Error>.Some break
                    }
                } .type match {
                    case Type.Custom -> {}
                    case Type.Ptr -> { match {
                        case Type.Custom -> { ~ }
                        case _ -> { drop &void.token "expected to match on a variant" error make Maybe<Error>.Some break }
                    } }
                    case _ -> { drop &void.token "expected to match on a variant" error make Maybe<Error>.Some break }
                } .type-definition @varint
                $ctx &varint lookup-type-definition match {
                    case TypeDefinition.Struct -> {
                        drop &void.token "expected to match on a variant" error make Maybe<Error>.Some break
                    }
                    case TypeDefinition.Variant -> {}
                } @varint
                $varint.cases.len 0 /= if {
                    &void.token "expected a variant with zero cases" error make Maybe<Error>.Some break
                }
                0 1 =
            }
        } if {
            $ctx.temp &ctx.deferred $void make DeferredInfer.StackVoid $ctx.progress make DeferredInferAtProgress make DeferredItem.DeferredInfer Array:push-front
        }
        $ctx logging if { $ctx.fmt Fmt:dedent }
        make Maybe.None
    }
}

fn generic-types-from-generic-parameters(arena: .Arena, parameters: .Array<Token>) -> Array<Type> {
    $arena $parameters.len Array:new-with-capacity @types
    0 loop {
        @i $i $parameters.len = if { $types break }
        &types $parameters $i Array:get ~ $i make GenericType make Type.Generic Array:push-assert-no-alloc
        $i 1 +
    }
}

fn call-argument-mismatch-error(
    ctx: .Ctx,
    token: .Token,
    signature: Unstacked:Signature,
    generic-arguments: .Array<InferenceHole>,
    argument-types: .Array<Maybe<TypeWithOrigin>>,
) -> Error {
    $ctx.arena $signature Signature-parameters @parameters

    $ctx.arena Fmt:into-new-string @msg @fmt
    &fmt "call to `" Fmt:write
    &fmt $token Token-lexeme Fmt:write
    &fmt "` expected the following arguments:\n\t" Fmt:write
    &fmt &ctx.type-lookup &parameters Type:Types-pretty-bracketed
    0 loop {
        @i $i $generic-arguments.len = if { break }
        &fmt "\n\t" Fmt:write
        $generic-arguments $i Array:get<_> @generic-argument
        $signature match {
            case Unstacked:Signature.Function -> {
                .generic-parameters $i Array:get
                &fmt flip Token-lexeme Fmt:write
            }
            case Unstacked:Signature.Intrinsic -> {
                .generic-parameters $i Array:get
                &fmt flip ~ ByteSlice:unpack Fmt:write
            }
        }
        &fmt " = " Fmt:write
        $ctx $generic-argument ~ lookup-hole match {
            case None -> { &fmt "unknown" Fmt:write }
            case Some -> { &fmt flip &ctx.type-lookup flip Type:pretty }
        }
        $i 1 +
    }
    &fmt "\nbut got:\n\t[" Fmt:write
    0 loop {
        @i $i $argument-types.len = if { break }
        $argument-types $i Array:get<_> match {
            case None -> { &fmt "_" Fmt:write  }
            case Some -> { .type &fmt flip &ctx.type-lookup flip Type:pretty }
        }
        $i 1 + $argument-types.len /= if { &fmt ", " Fmt:write }
        $i 1 +
    }
    &fmt "]" Fmt:write
    $token $msg Array:unpack<_> error
}

variant InferenceState {
    case BeingChecked
    case BeingInferred
    case Known -> TypeWithOrigin
}
fn InferenceState-format(fmt: .Formatter, self: .InferenceState) {
    $fmt $self match {
        case BeingChecked -> { "BeingChecked" }
        case BeingInferred -> { "BeingInferred" }
        case Known -> { $fmt "(Known " Fmt:write $fmt flip TypeWithOrigin-format ")" }
    } Fmt:write 
}

fn ptr-eq<T>(a: ..T, b: ..T) -> bool { $a ~ $b ~ = }

variant LogLevel {
    case NoLogs
    case OnlyStructure
    case FullSources
}

variant DeferredInfer {
    case StackVoid -> .StackVoid
}

struct DeferredInferAtProgress {
    deferred: DeferredInfer
    progress: i32
}

struct DeferredCheck {
    source: .Source
    known: TypeWithOrigin
    progress: i32
}

variant DeferredItem {
    case DeferredCheck -> DeferredCheck
    case DeferredInfer -> DeferredInferAtProgress
}

struct Ctx {
    arena: .Arena
    temp: .Arena
    log-level: LogLevel
    fmt: .Formatter
    function-handle: FunctionHandle
    modules: .Array<Resolved:Module>
    module-id: ModuleId
    type-lookup: TypeLookup
    locals: .Map<LocalId, Unstacked:Local>
    states: Map<.Source, InferenceState>
    globals: .Array<Resolved:Global>
    closures: .Array<Unstacked:UnClosure>
    environment-types: .Array<Maybe<Type:CustomTypeType>>
    holes: Holes
    origins: Array<Maybe<List<Origin>>>
    nodes: .Array<MultiReturnNode>
    field-holes: Array<Maybe<i32>>
    type-bool: .Type
    type-i32: .Type
    custom-type-signatures: Map<CustomTypeHandle, FunctionSignature>
    deferred: Array<DeferredItem>
    progress: i32
    ignore-being-inferred: bool
}
fn logging(self: .Ctx) -> bool {
    $self.log-level make LogLevel.NoLogs /=
}
fn full-sources(self: .Ctx) -> bool {
    $self.log-level make LogLevel.FullSources =
}

fn lookup-hole(ctx: .Ctx, hole: InferenceHole) -> Maybe<.Type> {
    &ctx.holes &hole Holes-lookup
}
fn defer-check(ctx: .Ctx, source: .Source, known: .TypeWithOrigin) {
    $ctx logging if {
        $ctx.fmt "defering check: " Fmt:write
        $ctx.fmt $known TypeWithOrigin-format
        $ctx.fmt "=" Fmt:write
        $ctx.fmt $source Source-format
        $ctx.fmt "\n" Fmt:write
    }
    $ctx.temp &ctx.deferred make DeferredCheck {
        $source @source
        $ctx.temp &known.type Type:clone $known.origin make TypeWithOrigin @known
        $ctx.progress @progress
    } make DeferredItem.DeferredCheck Array:push
}

fn fix-function-handle(ctx: .Ctx, function-handle: FunctionHandle) -> FunctionHandle {
    $ctx.modules $function-handle.module.index Array:get @resolved-module
    0 @shifted-id
    0 loop {
        @i $i $resolved-module.functions.values.len = if { 0 0 / drop uninit break }
        $i $function-handle.index = if {
            $function-handle.module $shifted-id make FunctionHandle break
        }
        &resolved-module.functions.values $i Array:get match {
            case Resolved:FunctionOrExtern.Extern -> { drop 1 }
            case Resolved:FunctionOrExtern.Function -> {
                @function
                $function.closure-count 1 +
            }
        } $shifted-id + #shifted-id
        $i 1 +
    }
}

fn Struct-signature(ctx: .Ctx, handle: CustomTypeHandle) -> .FunctionSignature { block {
    &ctx.custom-type-signatures &handle Map:get<_, _> match {
        case Some -> { break }
        case None -> {}
    }
    $ctx.modules $handle.module.index Array:get<_> @module
    &module.type-definitions.values $handle.index Array:get<_> match {
        case TypeDefinition.Struct -> {}
        case TypeDefinition.Variant -> { drop Core:unreachable<.Resolved:Struct> }
    } @struc

    $struc.name $handle
    $ctx.arena $struc.name &struc.generic-parameters generic-parameters-to-arguments
    make Type:CustomTypeType make Type.Custom @type

    make FunctionSignature {
        $struc.generic-parameters @generic-parameters
        $ctx.arena &struc.fields NamedTypes-to-Parameters @parameters
        $ctx.arena $type Array:singleton<_> @returns
    } $ctx.arena flip &ctx.custom-type-signatures flip $handle flip Map:insert<_, _> drop
    $ctx $handle Struct-signature
} }

fn NamedTypes-to-Parameters(arena: .Arena, named-types: .Array<NamedType>) -> Array<Parameter> {
    $arena $named-types.len Array:new-with-capacity @parameters
    0 loop {
        @i $i $named-types.len = if { $parameters break }
        $named-types $i Array:get @named-type
        &parameters $named-type.name $i $named-type.type make Parameter Array:push-assert-no-alloc
        $i 1 +
    }
}

fn Variant-signature(ctx: .Ctx, handle: CustomTypeHandle, tag: i32) -> .FunctionSignature { block {
    &ctx.custom-type-signatures &handle Map:get<_, _> match {
        case Some -> { break }
        case None -> {}
    }
    $ctx.modules $handle.module.index Array:get<_> @module
    &module.type-definitions.values $handle.index Array:get<_> match {
        case TypeDefinition.Struct -> { drop Core:unreachable<.Resolved:Variant> }
        case TypeDefinition.Variant -> {}
    } @varint

    $varint.name $handle
    $ctx.arena $varint.name &varint.generic-parameters generic-parameters-to-arguments
    make Type:CustomTypeType make Type.Custom @type

    &varint.cases $tag Array:get @cays
    make FunctionSignature {
        $varint.generic-parameters @generic-parameters
        $ctx.arena $cays.name make Name.User 0 &cays.type Maybe:ref Maybe:assert-some ~ make Parameter Array:singleton @parameters
        $ctx.arena $type Array:singleton<_> @returns
    } $ctx.arena flip &ctx.custom-type-signatures flip $handle flip Map:insert<_, _> drop
    $ctx $handle $tag Variant-signature
} }

fn generic-parameters-to-arguments(arena: .Arena, token: Token, generic-parameters: .Array<Token>) -> Array<Type> {
    $arena $generic-parameters.len Array:new-with-capacity<Type> @generic-arguments
    0 loop {
        @i $i $generic-parameters.len = if { break }
        &generic-arguments
        $token $i make Parser:GenericType make Type.Generic
        Array:push-assert-no-alloc<_>
        $i 1 +
    }
    $generic-arguments
}

fn get-node(ctx: .Ctx, index: i32) -> .MultiReturnNode {
    $ctx.nodes $index Array:get<_>
}

// fn fill-hole(ctx: .Ctx, hole: InferenceHole, known: .Type) {
//     $ctx full-sources if {
//         $ctx.fmt Fmt:write-indent
//         $ctx.fmt "fill-hole: " Fmt:write
//         $ctx.fmt &hole Unstacked:InferenceHole-format
//         $ctx.fmt ", " Fmt:write
//         $ctx.fmt $known Type:format
//         $ctx.fmt "\n" Fmt:write
//     }
//     $ctx.progress 1 + #ctx.progress
//     $ctx.arena &ctx.holes &hole $ctx.arena $known Type:clone Holes-fill
// }
fn fill-hole-and-origin(ctx: .Ctx, hole: InferenceHole, known: .Type, origin: .List<Origin>) {
    $ctx full-sources if {
        $ctx.fmt Fmt:write-indent
        $ctx.fmt "fill-hole: " Fmt:write
        $ctx.fmt &hole Unstacked:InferenceHole-format
        $ctx.fmt ", " Fmt:write
        $ctx.fmt $known Type:format
        $ctx.fmt "\n" Fmt:write
    }
    $ctx.progress 1 + #ctx.progress
    $ctx.arena &ctx.holes &hole $ctx.arena $known Type:clone Holes-fill
    $ctx.temp &ctx.origins make Maybe.None $hole.index
    $origin ~ make Maybe.Some
    Array:extending-set
}
fn fill-hole-with-origin(ctx: .Ctx, hole: InferenceHole, known: .TypeWithOrigin) {
    $ctx $hole &known.type $known.origin fill-hole-and-origin
}

fn lookup-origin(ctx: .Ctx, hole: InferenceHole) -> Maybe<.List<Origin>> {
    $ctx.origins.len $hole.index le if {
        make Maybe.None
    } else {
        &ctx.origins $hole.index Array:get Maybe:ref
    }
}
fn lookup-type-with-origin(ctx: .Ctx, hole: InferenceHole) -> Maybe<TypeWithOrigin> {
    $ctx $hole lookup-hole match {
        case None -> { make Maybe.None }
        case Some -> {
            $ctx $hole lookup-origin match {
                case None -> { drop make Maybe.None }
                case Some -> { flip ~ flip make TypeWithOrigin make Maybe.Some }
            }
        }
    }
}

fn fill-field-hole(ctx: .Ctx, hole: InferenceFieldHole, field: i32) {
    loop {
        $ctx.field-holes.len $hole.index gt if { break }
        $ctx.arena &ctx.field-holes make Maybe<i32>.None Array:push<_>
    }
    &ctx.field-holes $hole.index $field make Maybe<i32>.Some Array:set<_> match {
        case None -> {}
        case Some -> {
            $field /= if { 0 0 / drop }
        }
    }
}

fn lookup-type-definition(ctx: .Ctx, handle: .CustomTypeHandle) -> .TypeDefinition {
    $ctx.modules $handle.module.index Array:get<_> .type-definitions.values $handle.index Array:get<_>
}

fn lookup-function-signature(ctx: .Ctx, function: .FunctionHandle) -> .FunctionSignature {
    $ctx.modules      $function.module.index Array:get<_>
    .functions.values $function.index        Array:get<_>
    Resolved:FunctionOrExtern-signature
}

fn lookup-signature(ctx: .Ctx, function: SignatureHandle) -> Unstacked:Signature {
    $function match {
        case SignatureHandle.Function -> {
            $ctx flip & lookup-function-signature make Unstacked:Signature.Function
        }
        case SignatureHandle.Intrinsic -> {
            intrinsic-signatures flip & Map:get assert-some make Unstacked:Signature.Intrinsic
        }
    }
}

struct TypeAtFieldIndex {
    type: Type
    field: i32
}
fn TypeAtFieldIndex-unpack(self: TypeAtFieldIndex) -> Type, i32 {
    $self.type $self.field
}

fn traverse-fields(ctx: .Ctx, local-type: .TypeWithOrigin, fields: .Array<Unstacked:FieldAccess>) -> Result<TypeWithOrigin, Error> {
    $ctx full-sources if {
        $ctx.fmt Fmt:write-indent
        $ctx.fmt "traverse-fields:\n" Fmt:write
        $ctx.fmt Fmt:indent
        $ctx.fmt Fmt:write-indent
        $ctx.fmt &local-type.type Type:format
        $ctx.fmt "\n" Fmt:write
        $ctx.fmt Fmt:write-indent
        $ctx.fmt \Unstacked:FieldAccess-format $fields Array:format-multi-line<_>
        $ctx.fmt "\n" Fmt:write
    }
    $local-type.type @type

    $ctx.temp make Origin.TODO $local-type.origin List:cons Arena:push @origin
    0 loop {
        @i $i $fields.len = if { $type $origin make TypeWithOrigin make Result<TypeWithOrigin, Error>.Success break }
        $fields $i Array:get<_> @access
        $ctx $access.source-type $type $origin make TypeWithOrigin & fill-hole-with-origin
        $type match {
            case Type.Ptr -> { ~ }
            case _ -> {}
        } #type
        &type match {
            case Type.Custom -> {
                @custom-type
                &custom-type.type-definition $ctx flip lookup-type-definition match {
                    case TypeDefinition.Variant -> {
                        drop
                        &access.name "variants do not have fields" error make Result.Error break
                    }
                    case TypeDefinition.Struct -> {}
                } @struc

                0 loop {
                    @i $i $struc.fields.len = if {
                        &access.name "field not found" error make Result<TypeAtFieldIndex, Error>.Error break
                    }
                    &struc.fields $i Array:get<_> @field
                    &field.name Name-unpack &access.name Token-lexeme Bytes:eq if {
                        $ctx.arena &field.type &custom-type.generic-arguments Type:with-generics
                        $i
                        make TypeAtFieldIndex make Result<TypeAtFieldIndex, Error>.Success break
                    }
                    $i 1 +
                } match {
                    case Error -> { make Result.Error break }
                    case Success -> {}
                }
            }
            case _ -> {
                drop
                &access.name "only structs have fields" error make Result.Error break
            }
        } TypeAtFieldIndex-unpack @field-index #type
        $ctx $access.target-type $type $origin make TypeWithOrigin & fill-hole-with-origin
        $ctx $access.field-index $field-index fill-field-hole
        $i 1 +
    }
    $ctx full-sources if {
        $ctx.fmt Fmt:write-indent
        $ctx.fmt "= " Fmt:write
        $ctx.fmt &type Type:format
        $ctx.fmt "\n" Fmt:write
        $ctx.fmt Fmt:dedent
    }
}

fn SourcePtr-format(fmt: .Formatter, self: ..Source) {
    $fmt $self ~ Source-format
}

fn check(ctx: .Ctx, source: .Source, known: .TypeWithOrigin) -> Maybe<Error> { block {
    $ctx logging if {
        $ctx.fmt Fmt:write-indent
        $ctx.fmt "> check: " Fmt:write
        $ctx.fmt $known TypeWithOrigin-format
        $ctx.fmt " = " Fmt:write
        $ctx.fmt $source $ctx full-sources if {
            Source:Source-format
        } else {
            Source:Source-format-shallow
        }
        $ctx.fmt "\n" Fmt:write
        $ctx.fmt Fmt:indent
    }
    &ctx.states &source Map:get<_, _> match {
        case None -> {}
        case Some -> {
            @state
            $state match {
                case Known -> {
                    @previous
                    &previous.type &known.type Type:eq not if {
                        $source Source-token "check expected different" error make Maybe<Error>.Some break
                    }
                    1 1 =
                }
                case BeingInferred -> { 1 1 = }
                case BeingChecked -> { 1 1 = }
            } if {
                $ctx logging if {
                    $ctx.fmt Fmt:write-indent
                    $ctx.fmt "< cycle detected: " Fmt:write
                    $ctx.fmt $state InferenceState-format
                    $ctx.fmt "\n" Fmt:write
                    $ctx.fmt Fmt:dedent
                }
                make Maybe<Error>.None break
            }
        }
    }
    0 1 = @dont-mark-known
    $ctx.arena &ctx.states $source make InferenceState.BeingChecked Map:insert<_, _> drop
    block (-> Maybe<Error>) {
        $source @whole-source
        $source match {
            case Source.FromNumber -> {
                @token &known.type match {
                    case Type.I32 -> { drop }
                    case _ -> {
                        drop
                        $token ~ $known.origin ~ $known.type make Error:NumberError make Error.Number make Maybe.Some break
                    }
                }
            }
            case Source.FromString -> {
                ~ @token
                &known.type match {
                    case Type.Ptr -> {
                        ~ match {
                            case Type.I8 -> { drop make Maybe<Error>.None break }
                            case _ -> { drop } } }
                    case _ -> { drop  } }
                $token $known.origin ~ $known.type make Error:StringError make Error.String make Maybe.Some break
            }
            case Source.FromLocal -> {
                @source
                $ctx $source.result-type lookup-hole match {
                    case None -> {}
                    case Some -> {
                        @result-type
                        $result-type &known.type Type:eq not if {
                            2 Fmt:to-fd @fmt
                            &fmt $source Source:FromLocal-format
                            &fmt "\n" Fmt:write
                            &fmt $result-type Type:format
                            &fmt " " Fmt:write
                            &fmt &known.type Type:format
                            &fmt "\n" Fmt:write
                            &source.token "expected local to have different type" error make Maybe<Error>.Some break
                        }
                        make Maybe<Error>.None break
                    }
                }
                $ctx.locals &source.var Map:get<_, _> Maybe:assert-some<_> @local
                $ctx $local.type lookup-type-with-origin match {
                    case None -> {
                        $source.fields.len 0 = if {
                            &local.assignments 0 Array:get<_> @initialization
                            $source.by-reference if {
                                &known.type match {
                                    case Type.Ptr -> { ~ }
                                    case _ -> { drop Core:unreachable<.Type> }
                                }
                            } else { &known.type } @expected-local-type

                            $ctx.temp $source.token $known.type make Origin:FromLocal make Origin.FromLocal $known.origin List:cons Arena:push @origin

                            $expected-local-type ~ $origin make TypeWithOrigin @expected

                            $ctx $local.type &expected fill-hole-with-origin
                            &initialization.source match {
                                case None -> { &initialization.token "expected item" error make Maybe<Error>.Some break }
                                case Some -> {}
                            } $ctx flip &expected check match {
                                case None -> {}
                                case _ -> { break }
                            }
                            $ctx $source.result-type $known fill-hole-with-origin
                            $ctx $local &expected check-local-assignments break
                        } else {
                            &ctx.states &whole-source Map:remove<_, _> drop
                            $ctx $whole-source infer match {
                                case InferenceResult.Error -> { make Maybe<Error>.Some break }
                                case InferenceResult.Success -> {}
                                case InferenceResult.Fail -> {
                                    1 1 = #dont-mark-known
                                    $ctx $whole-source $known defer-check make Maybe.None break
                                }
                            } .type @type
                            &type &known.type Type:eq not if {
                                2 Fmt:to-fd @fmt
                                &fmt $source Source:FromLocal-format
                                &fmt "\n" Fmt:write
                                &fmt &type Type:format
                                &fmt " " Fmt:write
                                &fmt $known TypeWithOrigin-format
                                &fmt "\n" Fmt:write
                                &source.token "check FromLocal: mismatch" error make Maybe<Error>.Some break
                            }
                        }
                    }
                    case Some -> {
                        @local-type
                        $ctx &local-type &source.fields traverse-fields match {
                            case Success -> {}
                            case Error -> { make Maybe<Error>.Some break }
                        } @result-type

                        $ctx.temp $source.token $known.type make Origin:FromLocal make Origin.FromLocal $known.origin List:cons Arena:push @origin

                        $source.by-reference if {
                            $ctx.arena $result-type.type Arena:push<_> make Type.Ptr $origin make TypeWithOrigin
                        } else { $result-type } @result-type

                        &result-type.type &known.type Type:eq not if {
                            $source.token $known.type $result-type.type $known.origin ~ make Error:LocalError make Error.Local make Maybe.Some break
                        }

                        $ctx $source.result-type &result-type fill-hole-with-origin

                        $ctx $local make TypeWithOrigin {
                            $origin @origin
                            $local-type.type @type
                        } & check-local-assignments break
                    }
                }
            }
            case Source.FromGlobal -> {
                @source

                $ctx make Origin.TODO origin-singleton @origin
                $ctx $source.type $origin make TypeWithOrigin & &source.fields traverse-fields match {
                    case Error -> { make Maybe<Error>.Some break }
                    case Success -> {}
                } @result-type
                make TypeWithOrigin {
                    $result-type.origin @origin
                    $source.by-reference if { &result-type.type make Type.Ptr } else { $result-type.type } @type
                } @result-type
                $ctx $source.result-type &result-type fill-hole-with-origin
                &known.type &result-type.type Type:eq not if {
                    &source.token "expected global to have different type" error make Maybe<Error>.Some break
                }
            }
            case Source.FromMakeStruct -> {
                @source

                $ctx &source.type-definition lookup-type-definition match {
                    case TypeDefinition.Struct -> {}
                    case TypeDefinition.Variant -> {
                        drop
                        &source.token "`make` expected struct" error make Maybe<Error>.Some break
                    }
                } @struc

                $source.arguments.len $struc.fields.len /= if {
                    &source.token "`make struct` expected more arguments" error make Maybe<Error>.Some break
                }

                &known.type match {
                    case Type.Custom -> {}
                    case _ -> {
                        drop
                        &source.token "`make struct` only makes custom types" error make Maybe<Error>.Some break
                    }
                } @known-type

                $known-type.type-definition $source.type-definition /= if {
                    &source.token "expected different type" error make Maybe<Error>.Some break
                }

                $ctx $source.type $known fill-hole-with-origin

                $ctx $struc &source.arguments $known-type $known.origin check-make-struct-fields break
            }
            case Source.FromMakeVariant -> { $ctx flip $known check-from-make-variant break }
            case Source.FromNode -> { $ctx flip $known check-from-node break }
            case Source.FromCast -> {
                @source
                $ctx.arena &source.dst-type Type:without-holes match {
                    case Error -> {
                        // A cast like this: !._ is odd, but there is no reason it shouldn't be accepted eventually.
                        & "Holes are not yet supported here" error make Maybe<Error>.Some break
                    }
                    case Success -> {}
                } @dst-type
                &dst-type &known.type Type:eq not if {
                    &source.token "check FromCast: known /= dst-type" error make Maybe<Error>.Some break
                }
                $source.src match {
                    case None -> { &source.token "check FromCast: src is None" error make Maybe<Error>.Some break }
                    case Some -> {}
                } @src
                $ctx $src infer match {
                    case InferenceResult.Error -> { make Maybe<Error>.Some break }
                    case InferenceResult.Success -> {
                        $ctx flip $source.src-type flip & fill-hole-with-origin
                    }
                    case InferenceResult.Fail -> {
                        // TODO: what is the right thing to do here?
                        // The argument to the cast couldn't be inferred, but it might be inferrable later.
                        // When should we retry? Ever?
                        // Should this just error immediately instead?
                        &source.token "LOL" error make Maybe<Error>.Some break
                    }
                }
            }
            case Source.FromProxied -> {
                @source
                $ctx $source.source $known check
                $ctx $source.type $known fill-hole-with-origin
                break
            }
            case Source.FromCase -> {
                @source

                $source.scrutinee match {
                    case None -> {
                        &source.token "check FromCase: expected scrutinee" error make Maybe<Error>.Some break
                    }
                    case Some -> {}
                } @scrutinee

                $ctx $source.scrutinee-type lookup-type-with-origin match {
                    case None -> {
                        $ctx $scrutinee infer match {
                            case InferenceResult.Error -> { make Maybe<Error>.Some break }
                            case InferenceResult.Success -> {}
                            case InferenceResult.Fail -> {
                                // Because a match allows matching on both a variant and a ptr to a variant,
                                // the scrutinee-type cannot be determined from the output of a case.

                                // For example in this scenario:
                                // variant Maybe<T> {
                                //     case Some -> T
                                //     case None
                                // }
                                // fn foo() {
                                //     uninit match {
                                //         case Some -> {}
                                //         case None -> { 0 !.i32 }
                                //     } drop
                                // }
                                // The uninit could be:
                                //     uninit<.Maybe<i32>> with a match by reference
                                //   or
                                //     uninit<Maybe<.i32>> with a match by value.

                                // TODO: Allow match to have an annotation for the scrutinee-type
                                // to fall back to here.
                                //   match .Maybe<_> { ... }
                                // Even just knowing whether the annotated type starts with a dot is
                                // enough to make progress here.

                                &source.token "`match` failed to infer type of scrutinee" error make Maybe<Error>.Some break
                            }
                        } @scrutinee-type
                        $ctx $source.scrutinee-type &scrutinee-type fill-hole-with-origin
                        $scrutinee-type
                    }
                    case Some -> {}
                } @scrutinee-type

                $ctx &source.varint lookup-type-definition match {
                    case TypeDefinition.Struct -> {
                        drop &source.token "`match` expected variant" error make Maybe<Error>.Some break
                    }
                    case TypeDefinition.Variant -> {}
                } @varint
                &varint.cases $source.tag Array:get<_> .type Maybe:ref<_> Maybe:assert-some<_> @case-type

                &scrutinee-type.type match {
                    case Type.Ptr -> { ~ }
                    case _ -> {}
                } match {
                    case Type.Custom -> {}
                    case _ -> { drop &source.token "`match` can only match on variants" error make Maybe<Error>.Some break }
                } @scrutinee-custom-type
                $scrutinee-custom-type.type-definition $source.varint /= if {
                    // TODO: proper error message
                    &source.token "`match` expected to match on a different type" error make Maybe<Error>.Some break
                }
                $ctx.arena $case-type &scrutinee-custom-type.generic-arguments Type:with-generics &
                &scrutinee-type.type match {
                    case Type.Ptr -> { drop make Type:Type.Ptr }
                    case _ -> { drop ~ }
                } @case-type
                &case-type &known.type Type:eq not if {
                    $ctx.arena &source.token $known.origin "check: FromCase expected different" error-with-origin make Maybe<Error>.Some break
                }
            }
            case Source.FromFunRef -> {
                @source
                $ctx &source.function lookup-function-signature @signature

                &known.type match {
                    case Type.Fun -> {}
                    case _ -> {
                        drop
                        &source.token "check: FromFunRef: got function expected different" error make Maybe<Error>.Some break
                    }
                } @known-type

                $known-type.parameters.len $signature.parameters.len /=
                $known-type.returns.len $signature.returns.len /= or if {
                    &source.token "check: FromFunRef: expected different signature" error make Maybe<Error>.Some break
                }

                block {
                    0 loop {
                        @i $i $signature.parameters.len = if { make UnificationResult.Success break }
                        $ctx &source.generic-arguments
                        &signature.parameters $i Array:get<_> .type
                        &known-type.parameters $i Array:get<_> ~ $known.origin make TypeWithOrigin & // TODO: add node to origin
                        unify-types match {
                            case UnificationResult.Success -> {}
                            case _ -> { break }
                        }
                        $i 1 +
                    } match {
                        case UnificationResult.Success -> {}
                        case _ -> { break }
                    }
                    0 loop {
                        @i $i $signature.returns.len = if { make UnificationResult.Success break }
                        $ctx &source.generic-arguments
                        &signature.returns $i Array:get<_>
                        &known-type.returns $i Array:get<_> ~ $known.origin make TypeWithOrigin & // TODO: add node to origin
                        unify-types match {
                            case UnificationResult.Success -> {}
                            case _ -> { break }
                        }
                        $i 1 +
                    }
                } match {
                    case UnificationResult.Success -> {}
                    case _ -> {
                        drop &source.token "check: FromFunRef: TODO" error make Maybe<Error>.Some break
                    }
                }
            }
            case Source.FromGetField -> {
                @source
                $ctx.arena &ctx.states $whole-source make InferenceState.BeingInferred Map:insert<_, _> drop
                $ctx $whole-source infer match {
                    case InferenceResult.Error -> { make Maybe<Error>.Some break }
                    case InferenceResult.Success -> {}
                    case InferenceResult.Fail -> {
                        &source.token "check: FromGetField: failed to infer type of struct" error make Maybe<Error>.Some break
                    }
                } .type @type
                &type &known.type Type:eq not if {
                    &source.token "expected different" error make Maybe<Error>.Some break
                }
            }
            case Source.FromClosure -> {
                @source
                $known.type match {
                    case Type.Closure -> {}
                    case _ -> { drop &source.token "check FromClosure: TODO" error make Maybe.Some break }
                } @known-type

                $known-type.parameters.len $source.parameters.len /= if {
                    &source.token "check FromClosure: TODO known.parameters.len /= source.parameters.len" error make Maybe.Some break
                }
                $known-type.returns.len $source.return-types.len /= if {
                    &source.token "check FromClosure: TODO $known.returns.len /= $source.return-types.len" error make Maybe.Some break
                }

                0 loop {
                    @i $i $known-type.parameters.len = if { break }
                    $ctx
                    &source.parameters $i Array:get ~
                    &known-type.parameters $i Array:get ~ $known.origin make TypeWithOrigin & // TODO: add a node to the origin
                    fill-hole-with-origin
                    $i 1 +
                }

                0 loop {
                    @i $i $known-type.returns.len = if { make Maybe.None break }
                    $ctx &source.return-types $i Array:get ~
                    &known-type.returns $i Array:get ~ $known.origin make TypeWithOrigin & // TODO: add a node to the origin
                    fill-hole-with-origin

                    $ctx
                    &source.returns $i Array:get
                    make TypeWithOrigin {
                        &known-type.returns $i Array:get ~ @type
                        $ctx.temp make Origin.TODO $known.origin List:cons Arena:push @origin
                    } & check match {
                        case None -> {}
                        case _ -> { break }
                    }
                    $i 1 +
                } match {
                    case None -> {}
                    case _ -> { break }
                }
            }
            case Source.FromClosureParameter -> {
                @source
                $ctx $source.parameter $known fill-hole-with-origin
            }
        }
        make Maybe<Error>.None
    }
    $dont-mark-known not if {
        $ctx.arena &ctx.states $source
        $ctx.arena &known.type Type:clone $known.origin make TypeWithOrigin
        make InferenceState.Known Map:insert<_, _> drop
    }
    $ctx logging if { $ctx.fmt Fmt:dedent }
} }

fn check-match-scrutinee-variant(ctx: .Ctx, source: .Source:FromMatchExit, scrutinee-type: .TypeWithOrigin) -> Maybe<Error> {
    &scrutinee-type.type match {
        case Type.Custom -> { .type-definition make Maybe<.CustomTypeHandle>.Some }
        case Type.Ptr -> { ~ match {
            case Type.Custom -> { .type-definition make Maybe<.CustomTypeHandle>.Some }
            case _ -> { drop make Maybe<.CustomTypeHandle>.None }
        } }
        case _ -> { drop make Maybe<.CustomTypeHandle>.None }
    } match {
        case None -> {
            &source.token "check FromMatchExit: expected variant" error make Maybe<Error>.Some
        }
        case Some -> {
            @actual
            $actual &source.varint CustomTypeHandle-eq not if {
                $ctx.arena Fmt:into-new-string @msg @fmt
                &fmt "match argument mismatch.\nExpected to match on:\n\t" Fmt:write
                &fmt $ctx &source.varint lookup-type-definition TypeDefinition-name Token-lexeme Fmt:write
                &fmt "\nbut got:\n\t" Fmt:write
                &fmt $ctx $actual lookup-type-definition TypeDefinition-name Token-lexeme Fmt:write
                &source.token $msg Array:unpack<_> error make Maybe<Error>.Some
            } else {
                make Maybe<Error>.None
            }
        }
    }
}

fn check-from-make-variant(ctx: .Ctx, source: .Source:FromMakeVariant, known: .TypeWithOrigin) -> Maybe<Error> { block {
    &known.type match {
        case Type.Custom -> {}
        case _ -> {
            drop
            &source.token "check FromMakeVariant expected different" error make Maybe<Error>.Some break
        }
    } @known-type

    $known-type.type-definition $source.type-definition /= if {
        &source.token "check FromMakeVariant expected different" error make Maybe<Error>.Some break
    }

    $ctx &source.type-definition lookup-type-definition match {
        case TypeDefinition.Struct -> { drop Core:unreachable<.Resolved:Variant> }
        case TypeDefinition.Variant -> {}
    } @varint
    &varint.cases $source.tag Array:get<_> @cays

    &cays.type match {
        case None -> {}
        case Some -> {
            $ctx.arena flip &known-type.generic-arguments Type:with-generics @source-type
            $source.source match {
                case None -> {
                    &source.token "check FromMakeVariant expected input" error make Maybe<Error>.Some break
                }
                case Some -> {
                    $ctx flip make TypeWithOrigin {
                        $source-type @type
                        $ctx.temp make Origin.TODO $known.origin List:cons Arena:push @origin
                    } & check match {
                        case None -> {}
                        case _ -> { break }
                    }
                }
            }
        }
    }
    $ctx $source.type $known fill-hole-with-origin
    make Maybe<Error>.None
} }

fn check-from-node(ctx: .Ctx, source: .Source:FromNode, known: .TypeWithOrigin) -> Maybe<Error> { block {
    $source @entire-source
    $source.ret @return-depth
    $ctx $source.index get-node @node

    $ctx logging if {
        $ctx.fmt Fmt:write-indent
        $ctx.fmt "check: " Fmt:write
        $ctx.fmt $known TypeWithOrigin-format
        $ctx.fmt " = " Fmt:write
        $ctx.fmt $node $return-depth Graph:graph-node-name
        $ctx.fmt "\n" Fmt:write
    }

    $node match {
        case PlaceHolder -> { 0 !.Token "check FromNode encountered PlaceHolder" error make Maybe<Error>.Some break }
        case Call -> {
            @source
            $ctx $source.function lookup-signature @signature
            $signature Signature-returns .len ~ $return-depth - 1 - @return-index

            $source.arguments.len $signature Signature-parameters-len /= if {
                $ctx &source.arguments infer-over-array match {
                    case Error -> { make Maybe<Error>.Some break }
                    case Success -> {}
                } @argument-types
                $ctx &source.token $signature &source.generic-arguments &argument-types
                call-argument-mismatch-error make Maybe<Error>.Some break
            }

            $ctx $signature Signature-returns &source.generic-arguments $return-index $known fit-to-types match {
                case UnificationResult.Success -> {}
                case UnificationResult.Generics -> {
                    $source.token flip $return-index flip $known.type flip ~ make Error:CallGenericContradictionError make Error.CallGenericsContradict make Maybe.Some break
                }
                case UnificationResult.TypeMismatch -> {
                    $ctx &source.arguments infer-over-array match {
                        case Error -> { make Maybe<Error>.Some break }
                        case Success -> {}
                    } @argument-types
                    $ctx &source.token $signature &source.generic-arguments &argument-types
                    call-argument-mismatch-error make Maybe<Error>.Some break
                }
            }

            0 loop {
                @i $i $source.arguments.len = if { make Maybe<Error>.None break }
                &source.arguments $i Array:get<_> @argument
                $signature $i Unstacked:Signature-parameter @generic-parameter
                block {
                    $ctx $generic-parameter &source.generic-arguments try-with-generics match {
                        case None -> {
                            $ctx $argument infer match {
                                case InferenceResult.Error -> { make Maybe.Some break }
                                case InferenceResult.Success -> {}
                                case InferenceResult.Fail -> {
                                    $ctx $ctx.temp $entire-source ~ make Source.FromNode Arena:push $known defer-check
                                    make Maybe.None break
                                }
                            } @argument-type

                            $signature match {
                                case Signature.Function -> { $ctx flip .parameters &source.generic-arguments $i &argument-type fit-to-parameters }
                                case Signature.Intrinsic -> { $ctx flip .parameters &source.generic-arguments $i &argument-type fit-to-types }
                            } match {
                                case UnificationResult.Success -> {}
                                case _ -> {
                                    drop
                                    $ctx &source.arguments infer-over-array match {
                                        case Error -> { make Maybe<Error>.Some break }
                                        case Success -> {}
                                    } @argument-types
                                    $ctx &source.token $signature &source.generic-arguments &argument-types
                                    call-argument-mismatch-error make Maybe<Error>.Some break
                                }
                            }
                        }
                        case Some -> {
                            @parameter
                            $ctx.arena Arena:temp @arena @save
                            $arena $generic-parameter Type:generics @generics
                            $arena $save Arena:restore

                            $source.token $i $parameter make Origin:FromCall make Origin.FromCall
                            $generics.len 0 /= if {
                                $known.origin List:cons
                            } else {
                                empty-origin List:cons
                            } $ctx.temp flip Arena:push @origin
                            $ctx $argument $parameter $origin make TypeWithOrigin & check match {
                                case None -> {}
                                case _ -> { break }
                            }
                        }
                    }
                    make Maybe.None
                } match {
                    case None -> {}
                    case _ -> { break }
                }
                $i 1 +
            } match {
                case None -> {}
                case _ -> { break }
            }
            $signature match {
                case Signature.Intrinsic -> {
                    $ctx flip &source.token flip &source.generic-arguments flip &source.arguments check-generic-parameter-constraints match {
                        case None -> {}
                        case _ -> { break }
                    }
                } case _ -> { drop } }
        }
        case IfEntry -> {
            @source
            $source.parameters.len $return-depth - 1 - @return-index

            $ctx
            &source.parameters $return-index Array:get<_> ~
            $known fill-hole-with-origin

            $ctx &source.arguments $return-index Array:get<_> $known check match {
                case None -> {}
                case _ -> { break }
            }

            &source.condition match {
                case None -> { &source.token "If is missing condition" error make Maybe<Error>.Some break }
                case Some -> {}
            } @condition

            $ctx.temp $source.token make Origin.FromIf $known.origin List:cons Arena:push @origin
            $ctx $condition $source.token make Type.Bool $origin make TypeWithOrigin & check break
        }
        case IfExit -> {
            @source

            $ctx $source $return-depth infer-if-exit match {
                case InferenceResult.Fail -> {}
                case InferenceResult.Success -> {
                    @inferred
                    &inferred.type &known.type Type:eq not if {
                        $ctx.arena Fmt:into-new-string @string @fmt
                        &fmt "If was expected to return different: " Fmt:write
                        &fmt &ctx.type-lookup &inferred.type Type:pretty
                        &fmt " vs " Fmt:write
                        &fmt &ctx.type-lookup &known.type Type:pretty
                        &source.token $string Array:unpack<_> error make Maybe<Error>.Some break
                    }
                    make Maybe<Error>.None break
                }
                case InferenceResult.Error -> { make Maybe.Some break }
            }

            $source.return-types.len $return-depth - 1 - @return-index

            $ctx
            &source.return-types $return-index Array:get<_> ~
            $known fill-hole-with-origin


            make TypeWithOrigin {
                $known.type @type
                $ctx.temp make Origin.TODO $known.origin List:cons Arena:push @origin
            } & @known-for-branches

            &source.false-branch-returns $return-index Array:get<_> @false-source
            $ctx $false-source $known-for-branches check match {
                case None -> {}
                case _ -> { break }
            }

            &source.true-branch-returns match {
                case None -> {}
                case Some -> {
                    $return-index Array:get<_>
                    $ctx flip $known-for-branches check match {
                        case None -> {}
                        case _ -> { break }
                    }
                }
            }

            &source.condition match {
                case None -> { &source.token "If is missing condition" error make Maybe<Error>.Some break }
                case Some -> {}
            } @condition

            $ctx.temp $source.token make Origin.FromIf $known.origin List:cons Arena:push @origin
            $ctx $condition $source.token make Type.Bool $origin make TypeWithOrigin & check match {
                case None -> {}
                case _ -> { break }
            }
        }
        case BlockEntry -> {
            @source
            $source.parameters.len $return-depth - 1 - @return-index
            $ctx
            &source.parameters $return-index Array:get<_> ~
            $known fill-hole-with-origin

            $ctx
            &source.arguments $return-index Array:get<_>
            $known check break
        }
        case BlockExit -> {
            @source
            $ctx $source $return-depth infer-block-exit match {
                case InferenceResult.Error -> { make Maybe<Error>.Some break }
                case InferenceResult.Success -> {
                    @inferred
                    &inferred.type &known.type Type:eq not if {
                        &source.token "check FromBlockExit: expected different" error make Maybe<Error>.Some break
                    }
                    make Maybe<Error>.None break
                }
                case InferenceResult.Fail -> {}
            }
            $source.return-types.len $return-depth - 1 - @return-index

            $ctx
            &source.return-types $return-index Array:get<_> ~
            $known fill-hole-with-origin

            &source.break-returns $return-index Array:get<_> @break-returns
            0 loop {
                @i $i $break-returns.sources.len = if { make Maybe<Error>.None break }
                &break-returns.sources $i Array:get<_> .source match {
                    case None -> {
                        $ctx $source break-types-mismatch-error make Maybe<Error>.Some break
                    }
                    case Some -> {}
                } @return

                // TODO: add node to the origin
                $ctx $return $known check match {
                    case None -> {}
                    case _ -> { break }
                }
                $i 1 +
            } match {
                case None -> {}
                case _ -> { break }
            }
        }
        case LoopEntry -> {
            @source

            &source.next-arguments match {
                case None -> {}
                case Some -> {
                    .len ~ $source.arguments.len /= if {
                        &source.token "source.arguments.len != source.next-arguments.len" error make Maybe.Some break
                    } } }

            $source.parameters.len 1 - $return-depth - @return-index

            $ctx
            &source.parameters $return-index Array:get<_> ~
            $known fill-hole-with-origin

            // TODO: add node to origin

            $ctx
            &source.arguments $return-depth Array:get<_>
            $known check match {
                case None -> {}
                case _ -> { break }
            }

            &source.next-arguments match {
                case None -> {}
                case Some -> { $ctx flip $return-index Array:get $known check break }
            }
        }
        case MatchEntry -> {
            @source
            $source.parameters.len $return-depth - 1 - @return-index
            $ctx &source.parameters $return-index Array:get ~ lookup-hole match {
                case None -> {
                    $ctx &source.parameters $return-index Array:get ~ $known fill-hole-with-origin

                    // TODO: add a step to the origin for the MatchEntry node
                    $ctx &source.arguments $return-index Array:get $known check break
                }
                case Some -> {}
            } @previously-inferred
            $previously-inferred &known.type Type:eq not if {
                $ctx.nodes $source.exit-node Array:get match {
                    case MatchExit -> {}
                    case _ -> { drop Core:unreachable }
                } @exit-node
                make Error:MatchParametersMismatchError {
                    $source.token @token
                    $known.origin ~ @origin
                    $return-index @parameter-index
                    $ctx.arena &known.type Type:clone @expected
                    $ctx &source.parameters lookup-holes-individually @previously-inferred-parameters
                    $ctx &exit-node.return-types lookup-holes-individually @previously-inferred-returns
                    $ctx &source.parameters lookup-origins-individually @origin-of-previously-inferred-parameters
                } make Error.MatchParametersMismatch make Maybe.Some break
            }
        }
        case MatchExit -> {
            @source
            $source.return-types.len $return-depth - 1 - @return-index

            $ctx &source.return-types $return-index Array:get<_> ~ $known fill-hole-with-origin

            0 loop {
                @i $i $source.returns.len = if { make Maybe<Error>.None break }

                &source.returns $i Array:get<_> .returns $return-index Array:get<_> @source
                // TODO: add node to the origins of known
                $ctx $source $known check match {
                    case None -> {}
                    case _ -> { break }
                }

                $i 1 +
            } match {
                case None -> {}
                case _ -> { break }
            }

            &source.scrutinee match {
                case None -> {
                    &source.token "check FromMatchExit: expected scrutinee" error make Maybe<Error>.Some break
                }
                case Some -> {}
            } @scrutinee

            $ctx $source.scrutinee-type lookup-hole match {
                case None -> {
                    $ctx $scrutinee infer match {
                        case InferenceResult.Success -> {}
                        case InferenceResult.Error -> { make Maybe<Error>.Some break }
                        case InferenceResult.Fail -> {
                            &source.token "check FromMatchExit: failed to infer type of scrutinee" error make Maybe<Error>.Some break
                        }
                    } @scrutinee-type

                    $ctx $source.scrutinee-type &scrutinee-type fill-hole-with-origin

                    $ctx $source &scrutinee-type check-match-scrutinee-variant match {
                        case None -> {}
                        case _ -> { break }
                    }
                }
                case Some -> { drop }
            }

            make Maybe<Error>.None break
        }
        case IndirectCall -> {
            @source
            $source.return-types.len $return-depth - 1 - @return-index
            $ctx &source.return-types $return-index Array:get<_> ~ lookup-hole match {
                // case Some -> {} // TODO use this
                case _ -> {
                    drop
                    $source.function match {
                        case None -> {
                            &source.token "check IndirectCall: expected function as item on stack" error make Maybe<Error>.Some break
                        }
                        case Some -> {}
                    } @function
                    $ctx &source.parameters lookup-holes @parameters
                    $ctx &source.return-types lookup-holes @returns
                    $parameters match {
                        case Some -> {
                            @parameters
                            $returns match {
                                case Some -> {
                                    @returns
                                    $source.token $parameters $returns make Type:FunType
                                    make Maybe.Some
                                }
                                case None -> { make Maybe.None }
                            }
                        }
                        case None -> { make Maybe.None }
                    } match {
                        case Some -> {}
                        case None -> {
                            $ctx $function infer match {
                                case InferenceResult.Error -> { make Maybe<Error>.Some break }
                                case InferenceResult.Success -> { Core:dup $ctx flip $source.function-type flip & fill-hole-with-origin }
                                case InferenceResult.Fail -> {
                                    &source.token "check IndirectCall: failed to infer function type" error make Maybe<Error>.Some break
                                }
                            } .type match {
                                case Type.Fun -> {}
                                case Type.Closure -> {}
                                case _ -> {
                                    drop
                                    &source.token "check IndirectCall: expected function" error make Maybe<Error>.Some break
                                }
                            }
                        }
                    } @function-type
                    $function-type $source.closure if { make Type.Closure } else { make Type.Fun } @type-of-function-arg
                    make TypeWithOrigin {
                        $type-of-function-arg @type

                        // this TODO is difficult
                        $ctx make Origin.TODO origin-singleton @origin
                    } @type-of-function-arg
                    $ctx $source.function-type &type-of-function-arg fill-hole-with-origin
                    $ctx $function &type-of-function-arg check match {
                        case Some -> { make Maybe<Error>.Some break }
                        case None -> {}
                    }
                    $function-type.parameters.len $source.parameters.len /=
                    $function-type.returns.len $source.return-types.len /= or if {
                        &source.token "check IndirectCall: invalid annotation" error make Maybe<Error>.Some break
                    }

                    $ctx make Origin.TODO origin-singleton @origin
                    0 loop {
                        @i $i $function-type.parameters.len = if { break }
                        $ctx &source.parameters $i Array:get<_> ~ &function-type.parameters $i Array:get<_> ~ $origin make TypeWithOrigin & fill-hole-with-origin
                        $i 1 +
                    }
                    0 loop {
                        @i $i $function-type.returns.len = if { break }
                        $ctx &source.return-types $i Array:get<_> ~ &function-type.returns $i Array:get<_> ~ $origin make TypeWithOrigin & fill-hole-with-origin
                        $i 1 +
                    }

                    0 loop {
                        @i $i $function-type.parameters.len = if { make Maybe<Error>.None break }
                        $ctx
                        &source.arguments $i Array:get<_>
                        make TypeWithOrigin {
                            &function-type.parameters $i Array:get<_> ~ @type

                            // this TODO is difficult
                            $ctx.temp make Origin.TODO $ctx.temp List:empty Arena:push List:cons Arena:push @origin
                        } & check match {
                            case None -> {}
                            case _ -> { break }
                        }
                        $i 1 +
                    } match {
                        case None -> {}
                        case _ -> { break }
                    }

                    &function-type.returns $return-index Array:get<_>
                }
            } @return-type

            $return-type &known.type Type:eq not if {
                &source.token "check IndirectCall: expected different" error make Maybe<Error>.Some break
            }
            make Maybe<Error>.None break
        }
        case StackAnnotation -> {
            @source
            $source.types.len $return-depth - 1 - @return-index
            &source.types $return-index Array:get<_> @annotated
            $ctx.arena $annotated Type:without-holes match {
                case Error -> {
                    // TODO: support partial stack annotations like this:
                    //         :(i32, _, Array<_>)
                    drop Core:unreachable<Type>
                }
                case Success -> {}
            } @annotated
            &annotated &known.type Type:eq not if {
                $ctx $source stack-annotation-mismatch-error make Maybe<Error>.Some break
            }
            $ctx &source.arguments $return-index Array:get<_> make TypeWithOrigin {
                $known.type @type
                $ctx.temp $source.token $known.type make Origin:FromAnnotation make Origin.FromAnnotation $ctx.temp List:empty Arena:push List:cons Arena:push @origin
            } & check break
        }
    }
    make Maybe<Error>.None
} }

fn stack-annotation-mismatch-error(ctx: .Ctx, source: .Source:FromStackAnnotation) -> Error { block {
    $ctx.arena Fmt:into-new-string @msg @fmt
    &fmt "Stack doesn't match annotation:\n  actual:   [" Fmt:write
    0 loop {
        @i $i $source.arguments.len = if { make Maybe<Error>.None break }
        $ctx &source.arguments $i Array:get<_> infer match {
            case InferenceResult.Error -> { make Maybe<Error>.Some break }
            case InferenceResult.Success -> { &fmt flip &ctx.type-lookup flip & .type Type:pretty }
            case InferenceResult.Fail -> { &fmt "_" Fmt:write }
        }
        $i 1 + $source.arguments.len /= if { &fmt ", " Fmt:write }
        $i 1 +
    } match {
        case Some -> { break }
        case None -> {}
    }
    &fmt "]\n  expected: " Fmt:write
    &fmt &ctx.type-lookup &source.types WithHoles:Types-pretty-bracketed
    &source.token $msg Array:unpack<_> error
} }

fn check-local-assignments(ctx: .Ctx, local: .Unstacked:Local, expected: .TypeWithOrigin) -> Maybe<Error> { block {
    $local.assignments-checked if {
        make Maybe<Error>.None break
    }
    1 1 = #local.assignments-checked
    0 loop (i32 -> Maybe<Error>) {
        @i $i $local.assignments.len = if { make Maybe<Error>.None break }
        &local.assignments $i Array:get<_> @assignment
        $ctx $expected &assignment.fields traverse-fields match {
            case Error -> { make Maybe<Error>.Some break }
            case Success -> {}
        } @field-type
        $assignment.is-store if {
            &field-type.type match {
                case Type.Ptr -> { ~ }
                case _ -> {
                    drop
                    &assignment.token "assignment is store but operates on non-ptr" error make Maybe<Error>.Some break
                }
            }
        } else {
            &field-type.type
        } @source-type

        make TypeWithOrigin {
            $source-type ~ @type

            $field-type.origin
            // TODO: add a node to this list
            @origin
        } @expected-at-assignment

        $ctx $assignment.type &expected-at-assignment fill-hole-with-origin
        $ctx &assignment.source match {
            case None -> {
                &assignment.token "assignment expected item" error make Maybe<Error>.Some break
            }
            case Some -> {}
        } $expected-at-assignment & check match {
            case None -> {}
            case _ -> { break }
        }
        $i 1 +
    }
} }

fn try-with-generics(ctx: .Ctx, type: .Type, generic-arguments: .Array<InferenceHole>) -> Maybe<Type:Type> { block (-> Maybe<Type:Type>) {
    $type match {
        case Type.Generic -> {
            .index ~ $generic-arguments flip Array:get<_> ~ $ctx flip lookup-hole Maybe:deref<_> break
        }
        case Type.Ptr -> {
            ~ $ctx flip $generic-arguments try-with-generics match {
                case Some -> {
                    $ctx.arena flip Arena:push<_> make Type.Ptr
                }
                case _ -> { break }
            }
        }
        case Type.I8 -> { ~ make Type:Type.I8 }
        case Type.I32 -> { ~ make Type:Type.I32 }
        case Type.I64 -> { ~ make Type:Type.I64 }
        case Type.Bool -> { ~ make Type:Type.Bool }
        case Type.Custom -> {
            @type
            make Type:CustomTypeType {
                $type.token @token
                $type.type-definition @type-definition
                $ctx &type.generic-arguments $generic-arguments try-all-with-generics match {
                    case Some -> {}
                    case None -> { make Maybe<Type>.None break }
                } @generic-arguments
            }
            make Type.Custom
        }
        case Type.Fun -> {
            @type
            $type.token
            $ctx &type.parameters $generic-arguments try-all-with-generics match {
                case Some -> {}
                case None -> { make Maybe<Type>.None break }
            }
            $ctx &type.returns $generic-arguments try-all-with-generics match {
                case Some -> {}
                case None -> { make Maybe<Type>.None break }
            }
            make Type:FunType
            make Type.Fun
        }
        case Type.Closure -> {
            @type
            $type.token
            $ctx &type.parameters $generic-arguments try-all-with-generics match {
                case Some -> {}
                case None -> { make Maybe<Type>.None break }
            }
            $ctx &type.returns $generic-arguments try-all-with-generics match {
                case Some -> {}
                case None -> { make Maybe<Type>.None break }
            }
            make Type:FunType
            make Type.Closure
        }
    } make Maybe<Type>.Some
} }

fn try-all-with-generics(ctx: .Ctx, types: .Array<Type>, generic-arguments: .Array<InferenceHole>) -> Maybe<Array<Type:Type>> {
    $ctx.arena $types.len Array:new-with-capacity<Type> @filled
    loop (-> Maybe<Array<Type>>) {
        $filled.len $types.len = if { $filled make Maybe<Array<Type>>.Some break }
        &filled
        $ctx $types $filled.len Array:get<_> $generic-arguments try-with-generics match {
            case Some -> {}
            case None -> { make Maybe<Array<Type>>.None break }
        }
        Array:push-assert-no-alloc<_>
    }
}

fn fit-to-types(ctx: .Ctx, types: .Array<Type>, generic-arguments: .Array<InferenceHole>, index: i32, known: .TypeWithOrigin) -> UnificationResult {
    $ctx
    $generic-arguments
    $types $index Array:get<_>
    $known unify-types
}
fn fit-to-types-named(ctx: .Ctx, types: .Array<Type:NamedType>, generic-arguments: .Array<InferenceHole>, index: i32, known: .TypeWithOrigin) -> UnificationResult {
    $ctx
    $generic-arguments
    $types $index Array:get<_> .type
    $known unify-types
}
fn fit-to-parameters(ctx: .Ctx, parameters: .Array<Parameter>, generic-arguments: .Array<InferenceHole>, index: i32, known: .TypeWithOrigin) -> UnificationResult {
    $ctx
    $generic-arguments
    $parameters $index Array:get<_> .type
    $known unify-types
}

variant UnificationResult {
    case Success
    case Generics -> .Error:GenericsContradict // This is merely behind pointer for performance reasons. (UnificationResult can fit into an i64)
    case TypeMismatch
}
fn UnificationResult-merge(a: UnificationResult, b: UnificationResult) -> UnificationResult {
    $a match {
        case UnificationResult.Success -> { $b }
        case _ -> {}
    }
}

fn unify-types(ctx: .Ctx, generic-arguments: .Array<InferenceHole>, holey: .Type, known: .TypeWithOrigin) -> UnificationResult {
    $ctx full-sources if {
        $ctx.fmt Fmt:write-indent
        $ctx.fmt "unify-types(\n" Fmt:write
        $ctx.fmt Fmt:indent
        $ctx.fmt Fmt:write-indent
        $ctx.fmt "generic-arguments: " Fmt:write
        $ctx.fmt \Unstacked:InferenceHole-format $generic-arguments Array:format<_>
        $ctx.fmt ",\n" Fmt:write
        $ctx.fmt Fmt:write-indent
        $ctx.fmt "holey: " Fmt:write
        $ctx.fmt $holey Type:format
        $ctx.fmt ",\n" Fmt:write
        $ctx.fmt Fmt:write-indent
        $ctx.fmt "known: " Fmt:write
        $ctx.fmt &known.type Type:format
        $ctx.fmt Fmt:dedent
        $ctx.fmt "):\n" Fmt:write
        $ctx.fmt Fmt:indent
    }
    block {
        $holey match {
            case Type.Generic -> {
                .index ~ @generic-index
                $generic-arguments $generic-index Array:get<_> @hole
                $ctx $hole ~ lookup-hole match {
                    case Some -> {
                        @ty
                        &known.type $ty Type:eq not if {
                            make Error:GenericsContradict {
                                $generic-index @generic
                                $ty ~ @previous
                                $known.type @now
                            } $ctx.arena flip Arena:push<_> make UnificationResult.Generics break
                        }
                    }
                    case None -> {
                        $ctx $hole ~ $known fill-hole-with-origin
                    }
                }
                make UnificationResult.Success
            }
            case Type.Ptr -> {
                ~ @child
                $known.type match {
                    case Type.Ptr -> { ~ $known.origin make TypeWithOrigin }
                    case _ -> { drop make UnificationResult.TypeMismatch break }
                } @known
                $ctx $generic-arguments $child &known unify-types
            }
            case Type.Bool -> { drop make UnificationResult.Success }
            case Type.I8 -> { drop make UnificationResult.Success }
            case Type.I32 -> { drop make UnificationResult.Success }
            case Type.I64 -> { drop make UnificationResult.Success }
            case Type.Custom -> {
                @holey
                &known.type match {
                    case Type.Custom -> {}
                    case _ -> { drop make UnificationResult.TypeMismatch break }
                } @custom-type
                $custom-type.type-definition $holey.type-definition /= if {
                    make UnificationResult.TypeMismatch break
                }
                $ctx $generic-arguments &holey.generic-arguments &custom-type.generic-arguments unify-types-all
            }
            case Type.Fun -> {
                @holey

                $known.type match {
                    case Type.Fun -> {}
                    case _ -> { drop make UnificationResult.TypeMismatch break }
                } @fun-type

                $ctx $generic-arguments &holey.parameters &fun-type.parameters unify-types-all
                $ctx $generic-arguments &holey.returns &fun-type.returns unify-types-all
                UnificationResult-merge
            }
            case Type.Closure -> {
                @holey

                $known.type match {
                    case Type.Closure -> {}
                    case _ -> { drop make UnificationResult.TypeMismatch break }
                } @closure

                $ctx $generic-arguments &holey.parameters &closure.parameters unify-types-all
                $ctx $generic-arguments &holey.returns &closure.returns unify-types-all
                UnificationResult-merge
            }
        }
    }
    $ctx full-sources if { $ctx.fmt Fmt:dedent }
}
fn unify-types-all(ctx: .Ctx, generic-arguments: .Array<InferenceHole>, holey: .Array<Type>, known: .Array<Type:Type>) -> UnificationResult {
    $ctx make Origin.TODO origin-singleton @origin // TODO: this one is difficult
    0 loop {
        @i $i $holey.len = if { make UnificationResult.Success break }
        $ctx $generic-arguments
        $holey $i Array:get<_>
        $known $i Array:get<_> ~ $origin make TypeWithOrigin &
        unify-types match {
            case UnificationResult.Success -> {}
            case _ -> { break }
        }
        $i 1 +
    }
}

fn infer-all(ctx: .Ctx, sources: .Array<Source>) -> Result<Maybe<Array<TypeWithOrigin>>, Error> {
    $ctx.arena $sources.len Array:new-with-capacity @types
    0 loop {
        @i $i $sources.len = if { $types make Maybe.Some make Result.Success break }
        $ctx $sources $i Array:get infer match {
            case InferenceResult.Error -> { make Result.Error break }
            case InferenceResult.Fail -> { make Maybe.None make Result.Success break }
            case InferenceResult.Success -> {}
        }
        &types flip Array:push-assert-no-alloc
        $i 1 +
    }
}

fn infer-over-array(ctx: .Ctx, sources: .Array<Source>) -> Result<Array<Maybe<TypeWithOrigin>>, Error> {
    $ctx.arena $sources.len Array:new-with-capacity @types
    0 loop {
        @i $i $sources.len = if { $types make Result.Success break }
        $ctx $sources $i Array:get<_> infer match {
            case InferenceResult.Error -> { make Result.Error break }
            case InferenceResult.Success -> { make Maybe.Some }
            case InferenceResult.Fail -> { make Maybe.None }
        }
        &types flip Array:push-assert-no-alloc
        $i 1 +
    }
}

fn infer-all-case-returns(ctx: .Ctx, source: .Source:FromMatchExit, return-index: i32) -> Result<Array<Maybe<TypeWithOrigin>>, Error> {
    $ctx.arena $source.returns.len Array:new-with-capacity @types
    0 loop {
        @i $i $source.returns.len = if { $types make Result.Success break }
        &source.returns $i Array:get .returns @returns
        $returns.len $return-index le if {
            $ctx $source arms-type-mismatch-error make Result.Error break
        }
        $ctx $returns $return-index Array:get<_> infer match {
            case InferenceResult.Error -> { make Result.Error break }
            case InferenceResult.Success -> { make Maybe.Some }
            case InferenceResult.Fail -> { make Maybe.None }
        }
        &types flip Array:push-assert-no-alloc<_>
        $i 1 +
    }
}

variant InferenceResult {
    case Error -> Error
    case Success -> TypeWithOrigin
    case Fail
}

fn infer(ctx: .Ctx, source: .Source) -> InferenceResult {
    $source @entire-source
    $ctx logging if {
        $ctx.fmt Fmt:write-indent
        $ctx.fmt "> infer: " Fmt:write
        $ctx.fmt $source $ctx full-sources if {
            Source:Source-format
        } else {
            Source:Source-format-shallow
        }
        $ctx.fmt "\n" Fmt:write
        $ctx.fmt Fmt:indent
        // $ctx.fmt \SourcePtr-format \InferenceState-format &ctx.states Map:format-multi-line<_, _>
    }
    $ctx.temp make Origin.TODO $ctx.temp List:empty Arena:push List:cons Arena:push @origin
    block {
        &ctx.states &source Map:get<_, _> match {
            case None -> {
                $ctx.arena &ctx.states $source make InferenceState.BeingInferred Map:insert<_, _> Maybe:assert-none<_>
            }
            case Some -> {
                @state
                $ctx logging if {
                    $ctx.fmt Fmt:write-indent
                    $ctx.fmt "< cycle detected: " Fmt:write
                    $ctx.fmt $state InferenceState-format
                    $ctx.fmt "\n" Fmt:write
                }
                $state match {
                    case Known -> {
                        ~ make InferenceResult.Success
                        $ctx logging if { $ctx.fmt Fmt:dedent }
                        break
                    }
                    case BeingInferred -> {
                        // $ctx logging if { $ctx.fmt Fmt:dedent }
                        // make Maybe<Type>.None make Result<Maybe<Type:Type>, Error>.Success break
                    }
                    case BeingChecked -> {
                        $ctx logging if { $ctx.fmt Fmt:dedent }
                        make InferenceResult.Fail break
                    }
                }
            }
        }
        block (-> Result<Maybe<Type>, Error>) {
            $source @whole-source
            $source match {
                case Source.FromMakeStruct -> {
                    @source
                    // TODO: check source.arguments against source.type-definition.fields

                    $ctx &source.type-definition lookup-type-definition match {
                        case TypeDefinition.Struct -> {}
                        case TypeDefinition.Variant -> {
                            drop
                            &source.token "`make` expected struct" error make InferenceResult.Error break
                        }
                    } @struc

                    $source.arguments.len $struc.fields.len /= if {
                        &source.token "`make struct` expected more arguments" error make InferenceResult.Error break
                    }

                    $ctx $source.type-definition Struct-signature @signature
                    $ctx &source.token &source.generic-arguments &source.arguments $signature make Signature.Function 0 infer-signature-application match {
                        case InferenceResult.Success -> {}
                        case _ -> { break }
                    } @inferred

                    // make TypeWithOrigin {
                    //     $inferred @type
                    //     $ctx.temp make Origin.TODO $ctx.temp List:empty Arena:push List:cons Arena:push @origin
                    // } @inferred

                    $ctx $source.type &inferred fill-hole-with-origin

                    $ctx $struc &source.arguments &inferred.type match {
                        case Type.Custom -> {}
                        case _ -> { drop Core:unreachable<.Type:CustomTypeType> }
                    } $inferred.origin check-make-struct-fields match {
                        case None -> {}
                        case Some -> { make InferenceResult.Error break }
                    }

                    $inferred make InferenceResult.Success
                }
                case Source.FromMakeVariant -> {
                    @source

                    $ctx $source.type lookup-type-with-origin match {
                        case Some -> { make InferenceResult.Success break }
                        case None -> {}
                    }
                    $ctx &source.type-definition lookup-type-definition match {
                        case TypeDefinition.Struct -> { drop Core:unreachable<.Resolved:Variant> }
                        case TypeDefinition.Variant -> {}
                    } @varint

                    &varint.cases $source.tag Array:get<_> @cays

                    $ctx &source.generic-arguments lookup-holes match {
                        case None -> {}
                        case Some -> {
                            @generic-arguments
                            $source.token $source.type-definition $generic-arguments make Type:CustomTypeType make Type.Custom @inferred
                            $ctx.temp make Origin.TODO $ctx.temp List:empty Arena:push List:cons Arena:push @origin
                            $inferred $origin make TypeWithOrigin @inferred
                            $ctx $source.type &inferred fill-hole-with-origin
                            $ctx $source &inferred check-from-make-variant match {
                                case None -> {}
                                case Some -> { make InferenceResult.Error break }
                            }

                            &cays.type match {
                                case Some -> {
                                    $ctx.arena flip &generic-arguments Type:with-generics @source-type
                                    $source.source match {
                                        case None -> {
                                            &source.token "check FromMakeVariant expected input" error make InferenceResult.Error break
                                        }
                                        case Some -> {}
                                    }
                                    $ctx flip $source-type $origin make TypeWithOrigin & check match {
                                        case None -> {}
                                        case Some -> { make InferenceResult.Error break }
                                    }
                                }
                                case None -> {}
                            }

                            $inferred make InferenceResult.Success break
                        }
                    }

                    &cays.type match {
                        case None -> {
                            // This variant is a generic type, but here it is being constructed without
                            // arguments which could determine the generic arguments.
                            // For example something here:
                            //    `make Maybe.None`
                            // It is impossible to tell what the generic argument to Maybe is without more context.
                            make InferenceResult.Fail break
                        }
                        case Some -> {}
                    } @case-type

                    $source.source match {
                        case None -> {
                            &source.token "infer: FromMakeVariant: expected item" error make InferenceResult.Error break
                        }
                        case Some -> {}
                    } @case-source

                    $ctx $source.type-definition $source.tag Variant-signature @signature
                    $source.source match {
                        case Some -> { $ctx.arena flip ~ Array:singleton }
                        case None -> { Array:new }
                    } @arguments
                    $ctx &source.token &source.generic-arguments &arguments $signature make Signature.Function 0 infer-signature-application match {
                        case InferenceResult.Success -> {
                            @inferred
                            $ctx $source.type &inferred fill-hole-with-origin
                            $inferred make InferenceResult.Success
                        }
                        case _ -> { break }
                    }
                }
                case Source.FromNumber -> { ~ Core:dup make Type.I32 flip make Origin.FromNumber $ctx flip origin-singleton make TypeWithOrigin make InferenceResult.Success }
                case Source.FromString -> { ~ Core:dup $ctx.arena flip make Type.I8 Arena:push<_> make Type:Type.Ptr flip make Origin.FromString $ctx flip origin-singleton make TypeWithOrigin make InferenceResult.Success }
                case Source.FromLocal -> {
                    @source
                    $ctx $source.result-type lookup-type-with-origin match {
                        case Some -> { make InferenceResult.Success break }
                        case None -> {}
                    }
                    $ctx.locals &source.var Map:get<_, _> Maybe:assert-some<_> @local

                    $ctx $local.type lookup-type-with-origin match {
                        case Some -> {}
                        case None -> {
                            $ctx $local infer-local match {
                                case InferenceResult.Success -> {}
                                case _ -> { break }
                            }
                        }
                    } @inferred
                    $ctx $local.type &inferred fill-hole-with-origin

                    $ctx &inferred &source.fields traverse-fields match {
                        case Error -> { make InferenceResult.Error break }
                        case Success -> {}
                    } @type

                    $source.by-reference if {
                        $ctx.arena $type.type Arena:push<_> make Type.Ptr $type.origin make TypeWithOrigin
                    } else { $type } @type

                    $ctx.arena &ctx.states $whole-source $type make InferenceState.Known Map:insert<_, _> drop

                    $ctx $local &inferred check-local-assignments match {
                        case None -> {}
                        case Some -> { make InferenceResult.Error break }
                    }

                    $ctx $source.result-type &type fill-hole-with-origin

                    // $ctx $whole-source &type check match {
                    //     case None -> {}
                    //     case Some -> { make InferenceResult.Error break }
                    // }
                    $type make InferenceResult.Success
                }
                case Source.FromNode -> {
                    @from-node-source
                    $from-node-source.index @node-index
                    $from-node-source.ret @return-depth
                    $ctx $node-index get-node @node
                    $ctx logging if {
                        $ctx.fmt Fmt:write-indent
                        $ctx.fmt "> infer: " Fmt:write
                        $ctx.fmt $node $return-depth Graph:graph-node-name
                        $ctx.fmt "\n" Fmt:write
                    }
                    $node match {
                        case PlaceHolder -> { Core:unreachable }
                        case Call -> {
                            @source
                            $ctx $source.function lookup-signature @signature
                            $signature Signature-returns .len ~ $return-depth - 1 - @return-index
                            $ctx &source.token &source.generic-arguments &source.arguments $signature $return-index infer-signature-application match {
                                case InferenceResult.Success -> {}
                                case _ -> { break }
                            }  @inferred

                            &ctx.states &entire-source Map:get match {
                                case None -> {}
                                case Some -> { match {
                                    case BeingInferred -> { &ctx.states &entire-source Map:remove drop }
                                    case _ -> { drop }
                                } }
                            }
                            $ctx $entire-source &inferred check match {
                                case None -> {}
                                case Some -> { make InferenceResult.Error break }
                            }
                            $inferred make InferenceResult.Success
                        }
                        case IfEntry -> {
                            @source

                            $source.parameters.len $return-depth - 1 - @return-index
                            $ctx &source.arguments $return-index Array:get<_> infer match {
                                case InferenceResult.Success -> {}
                                case _ -> { break }
                            } @type
                            $ctx &source.parameters $return-index Array:get<_> ~ &type fill-hole-with-origin

                            &source.condition match {
                                case None -> { &source.token "If is missing condition" error make InferenceResult.Error break }
                                case Some -> {}
                            } @condition

                            $ctx $condition $source.token make Type.Bool $origin make TypeWithOrigin & check match {
                                case None -> {}
                                case Some -> { make InferenceResult.Error break }
                            }

                            $type make InferenceResult.Success
                        }
                        case IfExit -> { $ctx flip $return-depth infer-if-exit }
                        case BlockEntry -> {
                            @source
                            $source.parameters.len $return-depth - 1 - @return-index
                            $ctx &source.arguments $return-index Array:get<_> infer @res
                            &res match {
                                case InferenceResult.Success -> {
                                    $ctx flip
                                    &source.parameters $return-index Array:get<_> ~ flip
                                    fill-hole-with-origin
                                }
                                case InferenceResult.Fail -> {}
                                case InferenceResult.Error -> { ~ make InferenceResult.Error break }
                            }
                            $res
                        }
                        case BlockExit -> { $ctx flip $return-depth infer-block-exit }
                        case LoopEntry -> { $ctx flip $return-depth infer-loop-entry }
                        case MatchEntry -> {
                            @source
                            $source.parameters.len $return-depth - 1 - @return-index

                            &source.scrutinee match {
                                case None -> {
                                    &source.token "infer MatchEntry: expected scrutinee" error make InferenceResult.Error break
                                }
                                case Some -> {}
                            } @scrutinee

                            &source.arguments $return-index Array:get<_> @argument-source
                            $ctx $argument-source infer match {
                                case InferenceResult.Success -> {}
                                case _ -> { break }
                            } @inferred

                            make TypeWithOrigin {
                                $inferred.type @type

                                $ctx.temp
                                &source.case-tokens $from-node-source.extra-arg Array:get ~ make Origin.FromCaseParameter
                                $inferred.origin List:cons Arena:push @origin
                            } @inferred

                            $ctx &source.parameters $return-index Array:get<_> ~ &inferred fill-hole-with-origin

                            $ctx $source.scrutinee-type lookup-hole match {
                                case None -> {
                                    $ctx $scrutinee infer match {
                                        case InferenceResult.Success -> {}
                                        case _ -> { break }
                                    } @scrutinee-type

                                    $ctx $source.scrutinee-type &scrutinee-type fill-hole-with-origin
                                }
                                case Some -> { drop }
                            }

                            $inferred make InferenceResult.Success
                        }
                        case MatchExit -> {
                            @source
                            $source.return-types.len $return-depth - 1 - @return-index
                            $ctx $source $return-index infer-all-case-returns match {
                                case Success -> {}
                                case Error -> { make InferenceResult.Error break }
                            } @inferred-arms

                            &inferred-arms \load<Maybe<TypeWithOrigin>> Array:find-map<_, _> match {
                                case Some -> {}
                                case None -> { make InferenceResult.Fail break }
                            } @inferred

                            0 loop {
                                @i $i $source.returns.len = if { 0 1 = break }
                                &inferred-arms $i Array:get<_> match {
                                    case None -> {}
                                    case Some -> {
                                        .type &inferred.type Type:eq not if { 1 1 = break } } }
                                $i 1 +
                            } if {
                                $ctx $source arms-type-mismatch-error
                                make InferenceResult.Error break
                            }

                            $ctx &source.return-types $return-index Array:get<_> ~ &inferred fill-hole-with-origin

                            0 loop {
                                @i $i $source.returns.len = if { make Maybe<Error>.None break }

                                &source.returns $i Array:get<_> .returns $return-index Array:get<_> @source
                                $ctx $source &inferred check match {
                                    case None -> {}
                                    case _ -> { break }
                                }

                                $i 1 +
                            } match {
                                case None -> {}
                                case Some -> { make InferenceResult.Error break }
                            }

                            &source.scrutinee match {
                                case None -> {
                                    &source.token "infer FromMatchExit: expected scrutinee" error make InferenceResult.Error break
                                }
                                case Some -> {}
                            } @scrutinee

                            $ctx $source.scrutinee-type lookup-hole match {
                                case None -> {
                                    $ctx $scrutinee infer match {
                                        case InferenceResult.Success -> {}
                                        case InferenceResult.Fail -> {
                                            &source.token "infer FromMatchExit: failed to infer type of scrutinee" error make InferenceResult.Error break
                                        }
                                        case _ -> { break }
                                    } @scrutinee-type

                                    $ctx $source.scrutinee-type &scrutinee-type fill-hole-with-origin

                                    $ctx $source &scrutinee-type check-match-scrutinee-variant match {
                                        case None -> {}
                                        case Some -> { make InferenceResult.Error break }
                                    }
                                }
                                case Some -> { drop }
                            }

                            $inferred make InferenceResult.Success
                        }
                        case IndirectCall -> {
                            @source
                            $source.return-types.len $return-depth - 1 - @return-index
                            $ctx &source.return-types $return-index Array:get<_> ~ lookup-hole match {
                                // case Some -> {} // TODO use this
                                case _ -> {
                                    drop
                                    $source.function match {
                                        case None -> {
                                            &source.token "infer IndirectCall: expected function as item on stack" error make InferenceResult.Error break
                                        }
                                        case Some -> {}
                                    } @function
                                    $ctx &source.parameters lookup-holes @parameters
                                    $ctx &source.return-types lookup-holes @returns
                                    $parameters match {
                                        case Some -> {
                                            @parameters
                                            $returns match {
                                                case Some -> {
                                                    @returns
                                                    $source.token $parameters $returns make Type:FunType
                                                    make Maybe.Some
                                                }
                                                case None -> { make Maybe.None }
                                            }
                                        }
                                        case None -> { make Maybe.None }
                                    } match {
                                        case Some -> {
                                            @function-type
                                            $function-type $source.closure if { make Type.Closure } else { make Type.Fun }
                                            $ctx flip $function flip $origin make TypeWithOrigin & check match {
                                                case Some -> { make InferenceResult.Error break }
                                                case None -> {}
                                            }
                                            $function-type $origin
                                        }
                                        case None -> {
                                            $ctx $function infer match {
                                                case InferenceResult.Success -> {
                                                    Core:dup $ctx flip $source.function-type flip & fill-hole-with-origin
                                                }
                                                case _ -> { break }
                                            } @type-with-origin
                                            &type-with-origin.type match {
                                                case Type.Fun -> {}
                                                case Type.Closure -> {}
                                                case _ -> {
                                                    drop
                                                    &source.token "infer IndirectCall: expected function" error make InferenceResult.Error break
                                                }
                                            }
                                            ~ $type-with-origin.origin
                                        }
                                    } @function-type-origin @function-type

                                    $ctx.temp make Origin.TODO $function-type-origin List:cons Arena:push @origin
                                    $ctx $source.function-type $function-type $source.closure if { make Type.Closure } else { make Type.Fun } $origin make TypeWithOrigin & fill-hole-with-origin

                                    $function-type.parameters.len $source.parameters.len /=
                                    $function-type.returns.len $source.return-types.len /= or if {
                                        &source.token "infer IndirectCall: invalid annotation" error make InferenceResult.Error break
                                    }
                                    0 loop {
                                        @i $i $function-type.parameters.len = if { break }
                                        $ctx &source.parameters $i Array:get<_> ~ &function-type.parameters $i Array:get<_> ~ $origin make TypeWithOrigin & fill-hole-with-origin
                                        $i 1 +
                                    }
                                    0 loop {
                                        @i $i $function-type.returns.len = if { break }
                                        $ctx &source.return-types $i Array:get<_> ~ &function-type.returns $i Array:get<_> ~ $origin make TypeWithOrigin & fill-hole-with-origin
                                        $i 1 +
                                    }

                                    0 loop {
                                        @i $i $function-type.parameters.len = if { make Maybe<Error>.None break }
                                        $ctx
                                        &source.arguments $i Array:get<_>
                                        make TypeWithOrigin {
                                            &function-type.parameters $i Array:get<_> ~ @type
                                            $origin @origin
                                        } & check match {
                                            case None -> {}
                                            case _ -> { break }
                                        }
                                        $i 1 +
                                    } match {
                                        case None -> {}
                                        case Some -> { make InferenceResult.Error break }
                                    }

                                    &function-type.returns $return-index Array:get<_> ~ $origin make TypeWithOrigin
                                }
                            } make InferenceResult.Success
                        }
                        case StackAnnotation -> {
                            @source
                            $source.types.len $return-depth - 1 - @return-index
                            $ctx.arena &source.types $return-index Array:get<_> Type:without-holes match {
                                case Error -> {
                                    // TODO
                                    drop Core:unreachable<Type>
                                }
                                case Success -> {}
                            } @annotated
                            $ctx &source.arguments $return-index Array:get<_> infer match {
                                case InferenceResult.Success -> {
                                    @inferred
                                    &inferred.type &annotated Type:eq not if {
                                        $ctx $source stack-annotation-mismatch-error make InferenceResult.Error break
                                    }
                                    $inferred
                                }
                                case InferenceResult.Fail -> {
                                    $ctx.temp $source.token $annotated make Origin:FromAnnotation make Origin.FromAnnotation $origin List:cons Arena:push @origin
                                    $annotated $origin make TypeWithOrigin @annotated
                                    $ctx &source.arguments $return-index Array:get<_> &annotated check match {
                                        case None -> {}
                                        case Some -> { make InferenceResult.Error break }
                                    }
                                    $annotated
                                }
                                case _ -> { break }
                            } make InferenceResult.Success
                        }
                    }
                }
                case Source.FromCast -> {
                    @source
                    $ctx $source.src match {
                        case None -> { &source.src-type.token "cast expected item" error make InferenceResult.Error break }
                        case Some -> {}
                    } infer match {
                        case InferenceResult.Success -> {}
                        case InferenceResult.Fail -> {
                            &source.src-type.token "infer FromCast TODO: could not infer src-type" error make InferenceResult.Error break
                        }
                        case _ -> { break }
                    } @src-type
                    $ctx.arena &source.dst-type Type:without-holes match {
                        case Error -> {
                            & "holes are not supported here yet" error make InferenceResult.Error break
                        }
                        case Success -> {}
                    } @dst-type

                    // TODO: this should be FromCast not FromAnnotation
                    $ctx.temp $source.token $dst-type make Origin:FromAnnotation make Origin.FromAnnotation $origin List:cons Arena:push @origin

                    $dst-type $origin make TypeWithOrigin @dst-type

                    $ctx $source.src-type &src-type fill-hole-with-origin
                    $dst-type make InferenceResult.Success
                }
                case Source.FromCase -> {
                    @source
                    $source.scrutinee match {
                        case None -> {
                            &source.token "infer FromCase: expected scrutinee" error make InferenceResult.Error break
                        }
                        case Some -> {}
                    } @scrutinee
                    $ctx $source.scrutinee-type lookup-type-with-origin match {
                        case None -> {
                            $ctx $scrutinee infer match {
                                case InferenceResult.Success -> {}
                                case _ -> { break }
                            } @scrutinee-type
                            $ctx $source.scrutinee-type &scrutinee-type fill-hole-with-origin
                            $scrutinee-type
                        }
                        case Some -> {}
                    } @scrutinee-type
                    $ctx &source.varint lookup-type-definition match {
                        case TypeDefinition.Struct -> {
                            drop
                            $ctx &source.token "can only match on variants" error make InferenceResult.Error break
                        }
                        case TypeDefinition.Variant -> {}
                    } @varint

                    &scrutinee-type.type match {
                        case Type.Ptr -> { ~ }
                        case _ -> {}
                    } match {
                        case Type.Custom -> {}
                        case _ -> { drop $ctx &source.token "can only match on variants" error make InferenceResult.Error break }
                    } @scrutinee-varint-type
                    $scrutinee-varint-type.type-definition $source.varint /= if {
                        $ctx &source.token "match expected to match on different type" error make InferenceResult.Error break
                    }

                    &varint.cases $source.tag Array:get<_> .type match {
                        case None -> { Core:unreachable<.Type> }
                        case Some -> {}
                    }
                    $ctx.arena flip &scrutinee-varint-type.generic-arguments Type:with-generics
                    $ctx.arena flip Arena:push<_>
                    &scrutinee-type.type match {
                        case Type.Ptr -> { drop make Type:Type.Ptr }
                        case _ -> { drop ~ }
                    } @type

                    make TypeWithOrigin {
                        $type @type
                        $ctx.temp make Origin.TODO $origin List:cons Arena:push @origin
                    } make InferenceResult.Success
                }
                case Source.FromProxied -> {
                    @source
                    $ctx $source.source infer match {
                        case InferenceResult.Success -> {}
                        case _ -> { break }
                    } @type
                    $ctx $source.type &type fill-hole-with-origin
                    $type make InferenceResult.Success
                }
                case Source.FromGlobal -> {
                    @source
                    $ctx.temp make Origin.TODO $ctx.temp List:empty Arena:push List:cons Arena:push @origin
                    $ctx $source.type $origin make TypeWithOrigin & &source.fields traverse-fields match {
                        case Error -> { make InferenceResult.Error break }
                        case Success -> {}
                    }
                    $source.by-reference if {
                        @t
                        $ctx.arena $t.type Arena:push<_> make Type.Ptr $t.origin make TypeWithOrigin
                    } else {} @known
                    $ctx $source.result-type &known fill-hole-with-origin
                    $known make InferenceResult.Success
                }
                case Source.FromFunRef -> {
                    @source
                    $ctx &source.function lookup-function-signature @signature
                    $ctx &source.generic-arguments lookup-holes match {
                        case None -> { make InferenceResult.Fail break }
                        case Some -> {}
                    } @generic-arguments
                    $ctx.arena &signature.parameters \Parameter-type Array:map-ref @parameters
                    $ctx.arena &parameters &generic-arguments Type:all-with-generics @parameters
                    $ctx.arena &signature.returns &generic-arguments Type:all-with-generics @returns
                    $source.token $parameters $returns make Type:FunType make Type.Fun @inferred

                    $ctx.temp make Origin.TODO $ctx.temp List:empty Arena:push List:cons Arena:push @origin

                    $inferred $origin make TypeWithOrigin make InferenceResult.Success
                }
                case Source.FromGetField -> {
                    @source
                    $source.source match {
                        case None -> {
                            &source.token "infer FromGetField: expected item on stack" error make InferenceResult.Error break
                        }
                        case Some -> {}
                    } $ctx flip infer match {
                        case InferenceResult.Success -> {}
                        case _ -> { break }
                    } @base-type

                    $ctx $source.base-type &base-type fill-hole-with-origin

                    &base-type.type match {
                        case Type.Ptr -> { ~ 1 1 = }
                        case _ -> { 0 1 = }
                    } @on-ptr match {
                        case Type.Custom -> {}
                        case _ -> {
                            drop
                            &source.token "infer FromGetField: expected struct or ptr to struct" error make InferenceResult.Error break
                        }
                    } @custom-type
                    $ctx &custom-type.type-definition lookup-type-definition match {
                        case TypeDefinition.Variant -> {
                            drop
                            &source.token "infer FromGetField: expected struct" error make InferenceResult.Error break
                        }
                        case TypeDefinition.Struct -> {}
                    } @struc

                    $ctx &base-type &source.fields traverse-fields match {
                        case Success -> {}
                        case Error -> { make InferenceResult.Error break }
                    } @field-type

                    $ctx.temp make Origin.TODO $origin List:cons Arena:push @origin

                    $field-type $on-ptr if { @t $ctx.arena $t.type Arena:push<_> make Type.Ptr $t.origin make TypeWithOrigin } else {}
                    make InferenceResult.Success
                }
                case Source.FromClosure -> { $ctx flip infer-closure }
                case Source.FromClosureParameter -> {
                    @source
                    $ctx $source.parameter lookup-type-with-origin match {
                        case None -> { make InferenceResult.Fail }
                        case Some -> { make InferenceResult.Success }
                    } break
                }
                // case _ -> {
                //     @source
                //     $ctx logging if { $ctx.fmt $source Source:Source-format }
                //     $source Source:Source-token "infer TODO" error make InferenceResult.Error
                // }
            }
        } @res

        $ctx logging if {
            $ctx.fmt Fmt:write-indent
            $ctx.fmt "= " Fmt:write
        }
        &res match {
            case InferenceResult.Success -> {
                @inferred

                $ctx.arena &ctx.states $source
                $ctx.arena &inferred.type Type:clone $inferred.origin make TypeWithOrigin
                make InferenceState.Known Map:insert<_, _> drop

                $ctx logging if {
                    $ctx.fmt &inferred.type Type:format
                    $ctx.fmt "\n" Fmt:write
                }
            }
            case InferenceResult.Fail -> {
                $ctx logging if {
                    $ctx.fmt "None\n" Fmt:write
                }
                &ctx.states &source Map:get<_, _> match {
                    case None -> {}
                    case Some -> {
                        match {
                            case Known -> { drop }
                            case BeingChecked -> {}
                            case BeingInferred -> {
                                &ctx.states &source Map:remove<_, _> drop
                            }
                        }
                    }
                }
            }
            case _ -> { drop }
        }
        $ctx logging if { $ctx.fmt Fmt:dedent }
        $res
    }
}

// fn expect-the-thing(a: Result<Maybe<Array<TypeWithOrigin>>, Error>) -> Result<Maybe<Array<TypeWithOrigin>>, Error> { $a }

fn infer-closure(ctx: .Ctx, closure: .Source:FromClosure) -> InferenceResult { block (-> InferenceResult) {
    $ctx.arena $closure.returns.len Array:new-with-capacity<TypeWithOrigin> @return-types

    make TypeWithOrigin {
        make Type:FunType {
            $closure.token @token
            0 loop (i32 -> _) {
                @i $i $closure.returns.len = if { $return-types make Maybe.Some make Result<Maybe<Array<TypeWithOrigin>>, Error>.Success break }
                $ctx &closure.returns $i Array:get infer match {
                    case InferenceResult.Error -> { make Result.Error break }
                    case InferenceResult.Success -> {}
                    case InferenceResult.Fail -> { make Maybe.None make Result.Success break }
                } @return-type
                &return-types $return-type Array:push-assert-no-alloc
                $ctx &closure.return-types $i Array:get ~ &return-type fill-hole-with-origin
                $i 1 +
            } match {
                case Result.Error -> { make InferenceResult.Error break }
                case Result.Success -> {}
            } match {
                case None -> { make InferenceResult.Fail break }
                case Some -> {}
            } $ctx.arena flip & \TypeWithOrigin-type Array:map-ref @returns
            $ctx &closure.parameters lookup-holes match {
                case None -> { make InferenceResult.Fail break }
                case Some -> {}
            } @parameters
        } make Type.Closure @type
        $ctx make Origin.TODO origin-singleton @origin
    } make InferenceResult.Success
} }

fn check-make-struct-fields(ctx: .Ctx, struc: .Resolved:Struct, arguments: .Array<Source>, known: .Type:CustomTypeType, origin: .List<Origin>) -> Maybe<Error> {
    0 loop {
        @i $i $struc.fields.len = if { make Maybe<Error>.None break }
        &struc.fields $i Array:get<_> @field
        $ctx.arena &field.type &known.generic-arguments Type:with-generics @field-type
        $arguments $i Array:get<_> @field-source
        $ctx.temp make Origin.TODO $origin List:cons Arena:push @origin
        $ctx $field-source $field-type $origin make TypeWithOrigin & check match {
            case None -> {}
            case _ -> { break }
        }
        $i 1 +
    }
}

fn infer-loop-entry(ctx: .Ctx, source: .Source:FromLoopEntry, return-depth: i32) -> InferenceResult { block {
    &source.next-arguments match {
        case None -> {}
        case Some -> {
            .len ~ $source.arguments.len /= if {
                &source.token "source.arguments.len != source.next-arguments.len" error make InferenceResult.Error break
            } } }
    $source.parameters.len $return-depth - 1 - @return-index

    &source.parameters $return-index Array:get ~ @parameter-hole
    $ctx $parameter-hole lookup-hole match {
        case None -> {}
        case Some -> {
            ~ Core:dup $ctx flip $parameter-hole.token flip make Origin:FromAnnotation make Origin.FromAnnotation origin-singleton
            make TypeWithOrigin @parameter
            $ctx &source.arguments $return-depth Array:get &parameter check match {
                case None -> {}
                case Some -> { make InferenceResult.Error break }
            }
            $ctx $source $return-depth &parameter loop-entry-check-next-argument match {
                case None -> {}
                case Some -> { make InferenceResult.Error break }
            }
            $parameter make InferenceResult.Success break
        }
    }
    $ctx &source.arguments $return-depth Array:get<_> infer match {
        case InferenceResult.Success -> {}
        case InferenceResult.Fail -> {
            &source.next-arguments match {
                case None -> { make InferenceResult.Fail break }
                case Some -> {
                    $ctx flip $return-index Array:get<_> infer match {
                        case InferenceResult.Success -> {}
                        case _ -> { break } } } }
        }
        case _ -> { break }
    }
    @inferred
    $ctx.temp make Origin.TODO $inferred.origin List:cons Arena:push @origin
    $inferred.type $origin make TypeWithOrigin @inferred
    $ctx &source.arguments $return-depth Array:get<_> &inferred check match {
        case None -> {}
        case Some -> { make InferenceResult.Error break }
    }
    $ctx $source $return-depth &inferred loop-entry-check-next-argument match {
        case None -> {}
        case Some -> { make InferenceResult.Error break }
    }
    $ctx &source.parameters $return-index Array:get<_> ~ &inferred fill-hole-with-origin
    $inferred make InferenceResult.Success
} }
fn loop-entry-check-next-argument(ctx: .Ctx, source: .Source:FromLoopEntry, return-depth: i32, known: .TypeWithOrigin) -> Maybe<Error> {
    $source.parameters.len $return-depth - 1 - @return-index
    &source.next-arguments match {
        case None -> { make Maybe.None }
        case Some -> {
            $ctx.temp make Origin.TODO $known.origin List:cons Arena:push @origin
            $ctx flip $return-index Array:get<_> $known.type $origin make TypeWithOrigin & check
        }
    }
}

fn infer-block-exit(ctx: .Ctx, source: .Source:FromBlockExit, return-depth: i32) -> InferenceResult { block {
    $source.return-types.len $return-depth - 1 - @return-index

    &source.break-returns $return-index Array:get<_> @returns-of-breaks
    $ctx.arena $returns-of-breaks.sources.len Array:new-with-capacity<Maybe<TypeWithOrigin>> @inferred-break-types
    0 loop {
        @i $i $returns-of-breaks.sources.len = if { make Maybe<Error>.None break }
        &returns-of-breaks.sources $i Array:get<_> .source match {
            case None -> {
                $ctx $source break-types-mismatch-error make Maybe<Error>.Some break
            }
            case Some -> {}
        } @source
        $ctx $source infer match {
            case InferenceResult.Success -> { make Maybe.Some }
            case InferenceResult.Fail -> { make Maybe.None }
            case InferenceResult.Error -> { make Maybe<Error>.Some break }
        } &inferred-break-types flip Array:push-assert-no-alloc<_>

        $i 1 +
    } match {
        case Some -> { make InferenceResult.Error break }
        case None -> {}
    }

    &inferred-break-types \load<Maybe<TypeWithOrigin>> Array:find-map match {
        case Some -> {}
        case None -> { make InferenceResult.Fail break }
    } @inferred

    $ctx &source.return-types $return-index Array:get<_> ~ &inferred fill-hole-with-origin

    0 loop {
        @i $i $inferred-break-types.len = if { 0 1 = break }
        &inferred-break-types $i Array:get<_> match {
            case None -> {}
            case Some -> {
                .type &inferred.type Type:eq not if { 1 1 = break } } }
        $i 1 +
    } if {
        $ctx $source break-types-mismatch-error
        make InferenceResult.Error break
    }

    $ctx.temp make Origin.TODO $inferred.origin List:cons Arena:push @origin
    0 loop (i32 -> Maybe<Error>) {
        @i $i $inferred-break-types.len = if { make Maybe<Error>.None break }
        &inferred-break-types $i Array:get<_> match {
            case None -> {

                $ctx &returns-of-breaks.sources $i Array:get<_> .source match {
                    case None -> {
                        $ctx $source break-types-mismatch-error
                        make Maybe<Error>.Some break
                    }
                    case Some -> {}
                } $inferred.type $origin make TypeWithOrigin & check match {
                    case None -> {}
                    case _ -> { break }
                }
            }
            case Some -> { drop }
        }
        $i 1 +
    } match {
        case None -> {}
        case Some -> { make InferenceResult.Error break }
    }

    $inferred make InferenceResult.Success
} }

fn infer-if-exit(ctx: .Ctx, source: .Source:FromIfExit, return-depth: i32) -> InferenceResult { block {
    $source.return-types.len $return-depth - 1 - @return-index

    &source.condition match {
        case None -> { &source.token "If is missing condition" error make InferenceResult.Error break }
        case Some -> {}
    } @condition

    $ctx $source.token make Origin.FromIf origin-singleton @condition-origin
    $ctx $condition $source.token make Type.Bool $condition-origin make TypeWithOrigin & check match {
        case Some -> { make InferenceResult.Error break }
        case None -> {}
    }

    &source.true-branch-returns match {
        case Some -> {
            @true-branch-returns

            $true-branch-returns.len $source.false-branch-returns.len /= if {
                $ctx $source if-returns-mismatch-error make InferenceResult.Error break
            }

            $true-branch-returns $return-index Array:get<_> @true-return
            $ctx $true-return infer match {
                case InferenceResult.Success -> {
                    @inferred

                    $ctx &source.false-branch-returns $return-index Array:get<_> infer match {
                        case InferenceResult.Success -> {
                            @inferred-from-false
                            &inferred.type &inferred-from-false.type Type:eq not if {
                                $ctx $source if-returns-mismatch-error make InferenceResult.Error break
                            }
                            $ctx &source.return-types $return-index Array:get<_> ~ &inferred fill-hole-with-origin
                            $inferred make InferenceResult.Success break
                        }
                        case InferenceResult.Fail -> {}
                        case _ -> { break }
                    }

                    $ctx &source.return-types $return-index Array:get<_> ~ &inferred fill-hole-with-origin

                    $ctx.temp make Origin.TODO $inferred.origin List:cons Arena:push @origin
                    $ctx &source.false-branch-returns $return-index Array:get<_> $inferred.type $origin make TypeWithOrigin & check match {
                        case None -> {}
                        case Some -> { make InferenceResult.Error break }
                    }
                    $inferred
                }
                case InferenceResult.Fail -> {
                    $ctx &source.false-branch-returns $return-index Array:get<_> infer match {
                        case InferenceResult.Success -> {}
                        case _ -> { break }
                    } @inferred
                    $ctx &source.return-types $return-index Array:get<_> ~ &inferred fill-hole-with-origin
                    $ctx.temp make Origin.TODO $inferred.origin List:cons Arena:push @origin
                    $ctx $true-return $inferred.type $origin make TypeWithOrigin & check match {
                        case None -> {}
                        case Some -> { make InferenceResult.Error break }
                    }
                    $inferred
                }
                case _ -> { break }
            }
        }
        case None -> {
            $ctx &source.false-branch-returns $return-index Array:get<_> infer match {
                case InferenceResult.Success -> {}
                case _ -> { break }
            }  @inferred
            $ctx &source.return-types $return-index Array:get<_> ~ &inferred fill-hole-with-origin
            $inferred
        }
    } make InferenceResult.Success
} }

fn pretty-sources-inferred(fmt: .Formatter, ctx: .Ctx, sources: .Array<Source>) -> Maybe<Error> {
    0 loop {
        @i $i $sources.len = if { make Maybe<Error>.None break }
        $ctx $sources $i Array:get<_> infer match {
            case InferenceResult.Error -> { make Maybe<Error>.Some break }
            case InferenceResult.Success -> { .type $fmt flip &ctx.type-lookup flip & Type:pretty }
            case Fail -> { $fmt "_" Fmt:write }
        }
        $i 1 + $sources.len /= if {
            $fmt ", " Fmt:write
        }
        $i 1 +
    }
}

fn if-returns-mismatch-error(ctx: .Ctx, source: .Source:FromIfExit) -> Error { block {
    &source.true-branch-returns Maybe:ref<_> Maybe:assert-some<_> @true-branch-returns
    &source.false-branch-returns @false-branch-returns

    $ctx.arena Fmt:into-new-string @string @fmt
    &fmt "stack mismatch between if and else branch:" Fmt:write
    &fmt "\n\tif   [" Fmt:write
    &fmt $ctx $true-branch-returns pretty-sources-inferred match {
        case None -> {}
        case Some -> { break }
    }
    &fmt "]\n\telse [" Fmt:write
    &fmt $ctx $false-branch-returns pretty-sources-inferred match {
        case None -> {}
        case Some -> { break }
    }
    &fmt "]" Fmt:write
    &source.token $string Array:unpack<_> error
} }

fn arms-type-mismatch-error(ctx: .Ctx, source: .Source:FromMatchExit) -> Error {
    $ctx &source.varint lookup-type-definition match {
        case TypeDefinition.Struct -> { drop Core:unreachable<.Resolved:Variant> }
        case TypeDefinition.Variant -> {}
    } @varint

    $ctx.nodes $source.entry-node Array:get match {
        case MatchEntry -> {}
        case _ -> { drop Core:unreachable }
    } @entry-node

    $ctx.arena Fmt:into-new-string @string @fmt
    &fmt "arms of match case have different types:" Fmt:write
    0 loop {
        @i $i $source.returns.len = if { make Maybe<Error>.None break }
        &source.returns $i Array:get<_> @returns
        $returns.tag @tag &returns.returns @returns
        &fmt "\n\t[" Fmt:write
        0 loop (i32 -> Maybe<Error>) {
            @j $j $entry-node.parameters.len = if { make Maybe<Error>.None break }
            $ctx &entry-node.arguments $j Array:get infer match {
                case InferenceResult.Error -> { make Maybe.Some break }
                case InferenceResult.Success -> { .type &fmt flip &ctx.type-lookup flip & Type:pretty }
                case Fail -> { &fmt "_" Fmt:write }
            }
            $j 1 + $entry-node.parameters.len /= if { &fmt ", " Fmt:write }
            $j 1 +
        } match {
            case None -> {}
            case _ -> { break }
        }

        &fmt "] -> [" Fmt:write
        0 loop {
            @j $j $returns.len = if { make Maybe<Error>.None break }
            $ctx $returns $j Array:get<_> infer match {
                case InferenceResult.Error -> { make Maybe<Error>.Some break }
                case InferenceResult.Success -> { .type &fmt flip &ctx.type-lookup flip & Type:pretty }
                case InferenceResult.Fail -> { &fmt "_" Fmt:write }
            }
            $j 1 + $returns.len /= if { &fmt ", " Fmt:write }
            $j 1 +
        } match {
            case None -> {}
            case _ -> { break }
        }
        &fmt "] in case " Fmt:write
        &fmt $tag match {
            case None -> { "_" }
            case Some -> {
                &varint.cases flip Array:get<_>
                .name Token-lexeme
            }
        } Fmt:write
        $i 1 +
    } match {
        case Some -> {}
        case None -> { &source.token $string Array:unpack<_> error }
    }
}

fn break-types-mismatch-error(ctx: .Ctx, source: .Source:FromBlockExit) -> Error {
    $ctx.arena Fmt:into-new-string @msg @fmt
    &fmt "break stack mismatch:" Fmt:write
    &source.break-returns 0 Array:get<_> .sources.len ~ @break-count
    0 loop {
        @i $i $break-count = if { &source.token $msg Array:unpack<_> error break }
        &source.break-returns 0 Array:get<_> .sources $i Array:get<_> .token @break-token
        &fmt "\n\t" Fmt:write
        &fmt $break-token Token-line i32-format
        &fmt ":" Fmt:write
        &fmt $break-token Token-column i32-format
        &fmt " [" Fmt:write
        0 loop {
            @j $j $source.return-types.len = if { make Maybe<Error>.None break }
            &source.break-returns $j Array:get<_> .sources $i Array:get<_> .source match {
                case None -> {}
                case Some -> {
                    $ctx flip infer match {
                        case InferenceResult.Error -> { make Maybe<Error>.Some break }
                        case InferenceResult.Fail -> { &fmt "_" Fmt:write }
                        case InferenceResult.Success -> { .type &fmt flip &ctx.type-lookup flip & Type:pretty }
                    }
                    $j 1 + $source.return-types.len /= if { &fmt ", " Fmt:write }
                }
            }
            $j 1 +
        } match {
            case None -> {}
            case Some -> { break }
        }
        &fmt "]" Fmt:write
        $i 1 +
    }
}

fn infer-local(ctx: .Ctx, local: .Unstacked:Local) -> InferenceResult { block {
    $ctx $local.type lookup-type-with-origin match {
        case None -> {}
        case Some -> { make InferenceResult.Success break }
    }
    0 loop {
        @i $i $local.assignments.len = if { make InferenceResult.Fail break }
        &local.assignments $i Array:get<_> @assignment
        &assignment.source match {
            case None -> { &assignment.token "var assignment expected item on stack" error make InferenceResult.Error break }
            case Some -> {}
        } @assignment-source

        $assignment.fields.len 0 = if {
            $ctx $assignment-source infer match {
                case InferenceResult.Error -> { make InferenceResult.Error break }
                case InferenceResult.Fail -> {}
                case InferenceResult.Success -> {
                    @inferred-type-of-assignment-value
                    $assignment.is-store if {
                        $ctx.arena $inferred-type-of-assignment-value.type Arena:push<_> make Type.Ptr
                    } else { $inferred-type-of-assignment-value.type }
                    @local-type
                    make TypeWithOrigin {
                        $local-type @type
                        $ctx.temp $assignment.token $local-type make Origin:FromLocal make Origin.FromLocal $inferred-type-of-assignment-value.origin List:cons Arena:push @origin
                    } make InferenceResult.Success break
                }
            }
        }
        $i 1 +
    }
} }

fn infer-signature-application(
    ctx: .Ctx,
    token: .Token,
    generic-arguments: .Array<InferenceHole>,
    arguments: .Array<Source>,
    signature: Unstacked:Signature,
    return-index: i32,
) -> InferenceResult { block {
    $arguments.len $signature Signature-parameters-len /= if {
        $ctx $arguments infer-over-array match {
            case Error -> { make InferenceResult.Error break }
            case Success -> {}
        } @argument-types
        $ctx $token $signature $generic-arguments &argument-types
        call-argument-mismatch-error make InferenceResult.Error break
    }
    0 loop {
        @i $i $arguments.len = if { make Maybe<Error>.None break }
        $arguments $i Array:get<_> @argument
        $ctx $argument infer match {
            case InferenceResult.Error -> { make Maybe<Error>.Some break }
            case InferenceResult.Fail -> {}
            case InferenceResult.Success -> {
                @argument

                $signature match {
                    case Signature.Function -> { $ctx flip .parameters $generic-arguments $i &argument fit-to-parameters }
                    case Signature.Intrinsic -> { $ctx flip .parameters $generic-arguments $i &argument fit-to-types }
                } match {
                    case UnificationResult.Success -> {}
                    case _ -> {
                        drop
                        $ctx $arguments infer-over-array match {
                            case Error -> { make Maybe<Error>.Some break }
                            case Success -> {}
                        } @argument-types
                        $ctx $token $signature $generic-arguments &argument-types call-argument-mismatch-error make Maybe<Error>.Some break
                    }
                }
            }
        }
        $i 1 +
    } match {
        case Some -> { make InferenceResult.Error break }
        case None -> {}
    }
    $signature match {
        case Signature.Intrinsic -> {
            $ctx flip $token flip $generic-arguments flip $arguments check-generic-parameter-constraints match {
                case None -> {}
                case Some -> { make InferenceResult.Error break } }
        } case _ -> { drop } }
    $ctx $signature Signature-returns $return-index Array:get<_> $generic-arguments try-with-generics match {
        case None -> { make InferenceResult.Fail break }
        case Some -> {}
    } @inferred

    $inferred $ctx make Origin.TODO origin-singleton make TypeWithOrigin make InferenceResult.Success
} }

fn check-generic-parameter-constraints(
    ctx: .Ctx,
    token: .Token,
    generic-arguments: .Array<InferenceHole>,
    signature: .Resolved:IntrinsicSignature,
    arguments: .Array<Source>,
) -> Maybe<Error> {
    0 loop (i32 -> Maybe<Error>) {
        Core:dup $signature.constraints.len ge if { make Maybe.None break }
        Core:dup &signature.constraints flip Array:get match {
            case MustBeOneOf -> {
                @constraint
                $ctx $generic-arguments $constraint.generic Array:get ~ lookup-hole match {
                    case None -> {}
                    case Some -> {
                        &constraint.allowed flip \TypeShape-matches-Type flip Array:find not if {
                            $ctx $arguments infer-over-array match {
                                case Success -> {}
                                case Error -> { make Maybe.Some break }
                            } @argument-types
                            $ctx $token $signature make Signature.Intrinsic $generic-arguments &argument-types call-argument-mismatch-error
                            make Maybe.Some break
                        } drop
                    }
                }
            }
            case MustSatisfyPredicate -> {
                @constraint
                // TODO: this infer-over-array is expensive and it's not only called on error
                $ctx $arguments infer-over-array match {
                    case Success -> {}
                    case Error -> { make Maybe.Some break }
                } @argument-types

                $ctx.temp Arena:save @save
                $ctx.temp &argument-types \MaybeTypeWithOrigin-type Array:map-ref @argument-types
                &argument-types $constraint.predicate (_ -> _) 
                $ctx.temp $save Arena:restore
                match {
                    case None -> {}
                    case Some -> { $token flip ByteSlice:unpack error make Maybe.Some break }
                }
            }
        }
        1 +
    }
}

fn MaybeTypeWithOrigin-type(t: .Maybe<TypeWithOrigin>) -> Maybe<Type> {
    $t match {
        case None -> { make Maybe.None }
        case Some -> { .type ~ make Maybe.Some }
    }
}

fn Unit-format(fmt: .Formatter, unit: .Unit) {
    $fmt "Unit" Fmt:write
}

fn fill-holes-scope(ctx: .Ctx, scope: .Unstacked:Scope) -> Checked:Scope {
    $scope.id
    $ctx &scope.words fill-holes-words
    make Checked:Scope
}

fn fill-holes-words(ctx: .Ctx, words: .Array<Unstacked:Word>) -> Array<Checked:Word> {
    $ctx.arena $words.len Array:new-with-capacity<Checked:Word> @filled-words
    0 loop {
        @i $i $words.len = if { $filled-words break }

        &filled-words
        $ctx $words $i Array:get<_> fill-holes-word
        Array:push-assert-no-alloc<_>
        $i 1 +
    }
}

fn fill-holes-word(ctx: .Ctx, word: .Unstacked:Word) -> Checked:Word {
    $word match {
        case Unstacked:Word.Number -> { ~ make Checked:Word.Number }
        case Unstacked:Word.String -> { ~ make Checked:Word.String }
        case Unstacked:Word.GetLocal -> {
            @word
            $word.environment-fields match {
                case Maybe.None -> {
                    make Checked:GetLocal {
                        $word.name @name
                        $word.var @var
                        $ctx $word.var-type fill @var-type
                        $ctx &word.fields fill-holes-field-accesses @fields
                        $ctx $word.result-type fill @result-taip
                    }
                }
                case Maybe.Some -> {
                    @environment-fields

                    $ctx &word.fields fill-holes-field-accesses @fields
                    $ctx $word.var-type fill @var-type
                    $ctx $word.result-type fill @result-type
                    $ctx $word.name &environment-fields.path &fields &result-type add-environment-path-to-fields @fields

                    make Checked:GetLocal {
                        $word.name @name
                        $environment-fields.environment-local make VarId.Local @var
                        $var-type @var-type
                        $fields @fields
                        $result-type @result-taip
                    }
                }
            } make Checked:Word.GetLocal
        }
        case Unstacked:Word.RefLocal -> {
            @word
            $word.environment-fields match {
                case Maybe.None -> {
                    make Checked:RefLocal {
                        $word.name @name
                        $word.var @var
                        $ctx &word.fields fill-holes-field-accesses @fields
                    } make Checked:Word.RefLocal
                }
                case Maybe.Some -> {
                    @environment-fields

                    $ctx $word.var-type fill @var-type
                    $ctx &word.fields fill-holes-field-accesses @fields
                    $ctx $word.result-type fill @result-type
                    $ctx $word.name &environment-fields.path &fields &result-type add-environment-path-to-fields @fields
                    make Checked:GetLocal {
                        $word.name @name
                        $environment-fields.environment-local make VarId.Local @var
                        $fields @fields
                        $var-type @var-type
                        $result-type @result-taip
                    } make Checked:Word.GetLocal
                }
            }
        }
        case Unstacked:Word.Intrinsic -> { $ctx flip fill-holes-intrinsic make Checked:Word.Intrinsic }
        case Unstacked:Word.InitLocal -> {
            @word
            make Checked:InitLocal {
                $word.name @name
                $word.local @local
                $ctx $ctx.locals &word.local Map:get<_, _> Maybe:assert-some<_> .type ~ fill @type
            }
            make Checked:Word.InitLocal
        }
        case Unstacked:Word.MakeStruct -> {
            @word
            make Checked:MakeStruct {
                $word.token @token
                $ctx $word.type fill match {
                    case Type.Custom -> {}
                    case _ -> { drop Core:unreachable<Type:CustomTypeType> }
                } @type
            } make Checked:Word.MakeStruct
        }
        case Unstacked:Word.Call -> {
            @word
            make Checked:Call {
                $word.name @name
                $ctx $word.function fix-function-handle @function
                $ctx &word.generic-arguments fill-holes @generic-arguments
            } make Checked:Word.Call
        }
        case Unstacked:Word.Cast -> {
            @word
            make Checked:Cast {
                $word.token @token
                $ctx $word.src-type fill @src
                $ctx.arena &word.dst-type Type:without-holes match {
                    // TODO: dst-type should have an InferenceHole which gets filled here.
                    case Error -> { drop Core:unreachable<Type> }
                    case Success -> {}
                } @dst
            } make Checked:Word.Cast
        }
        case Unstacked:Word.SetLocal -> {
            @word
            $word.environment-fields match {
                case Maybe.None -> {
                    make Checked:SetLocal {
                        $word.name @name
                        $word.local make VarId.Local @var
                        $ctx &word.fields fill-holes-field-accesses @fields
                        $ctx $word.field-type fill @target-type
                    } make Checked:Word.SetLocal
                }
                case Maybe.Some -> {
                    @environment-fields

                    $ctx &word.fields fill-holes-field-accesses @fields
                    $ctx $word.field-type fill @target-type
                    $ctx $word.name &environment-fields.path &fields &target-type add-environment-path-to-fields @fields
                    make Checked:SetLocal {
                        $word.name @name
                        $environment-fields.environment-local make VarId.Local @var
                        $fields @fields
                        $target-type @target-type
                    } make Checked:Word.SetLocal
                }
            }
        }
        case Unstacked:Word.SetGlobal -> {
            @word
            make Checked:SetLocal {
                $word.name @name
                $word.globl make VarId.Global @var
                $ctx &word.fields fill-holes-field-accesses @fields
                $ctx $word.field-type fill @target-type
            } make Checked:Word.SetLocal
        }
        case Unstacked:Word.StoreLocal -> {
            @word
            make Checked:StoreLocal {
                $word.name @name
                $word.var make VarId.Local @var
                $ctx &word.fields fill-holes-field-accesses @fields
                $ctx $word.field-type fill @type
            } make Checked:Word.StoreLocal
        }
        case Unstacked:Word.If -> {
            @word
            make Checked:If {
                $word.token @token
                $ctx &word.parameters fill-holes @parameters
                &word.returns match {
                    case None -> { make Maybe<Array<Type>>.None }
                    case Some -> { $ctx flip fill-holes make Maybe<Array<Type>>.Some }
                } @returns
                $ctx &word.true-branch fill-holes-scope @true-branch
                $ctx &word.false-branch fill-holes-scope @false-branch
            } make Checked:Word.If
        }
        case Unstacked:Word.Block -> {
            @word
            make Checked:Block {
                $word.token @token
                $ctx &word.parameters fill-holes @parameters
                &word.returns match {
                    case None -> { make Maybe<Array<Type>>.None }
                    case Some -> { $ctx flip fill-holes make Maybe<Array<Type>>.Some }
                } @returns
                $ctx &word.body fill-holes-scope @body
            } make Checked:Word.Block
        }
        case Unstacked:Word.Loop -> {
            @word
            make Checked:Loop {
                $word.token @token
                $ctx &word.parameters fill-holes @parameters
                &word.returns match {
                    case None -> { make Maybe<Array<Type>>.None }
                    case Some -> { $ctx flip fill-holes make Maybe<Array<Type>>.Some }
                } @returns
                $ctx &word.body fill-holes-scope @body
            } make Checked:Word.Loop
        }
        case Unstacked:Word.Break -> { ~ make Checked:Word.Break }
        case Unstacked:Word.Sizeof -> { ~ make Checked:Word.Sizeof }
        case Unstacked:Word.MakeVariant -> {
            @word
            make Checked:VariantWord {
                $word.token @token
                $word.tag @tag
                $ctx $word.type fill match {
                    case Type.Custom -> {}
                    case _ -> { drop Core:unreachable<Type:CustomTypeType> }
                } @type
            } make Checked:Word.VariantWord
        }
        case Unstacked:Word.Match -> {
            @word
            $ctx $word.type fill match {
                case Type.Custom -> { 0 1 = }
                case Type.Ptr -> {
                    match {
                        case Type.Custom -> { ~ }
                        case _ -> { drop Core:unreachable<Type:CustomTypeType> }
                    }
                    1 1 =
                }
                case _ -> { drop Core:unreachable<Type:CustomTypeType> Core:unreachable<bool> }
            } @by-ref @type
            $ctx &type.type-definition lookup-type-definition match {
                case TypeDefinition.Variant -> {}
                case _ -> { drop Core:unreachable<.Resolved:Variant> }
            } @varint
            $ctx.arena $word.cases.len Array:new-with-capacity<Checked:MatchCase> @cases
            0 loop {
                @i $i $word.cases.len = if { break }
                &word.cases $i Array:get<_> @cays
                &varint.cases $cays.tag Array:get<_> .type match {
                    case None -> { make Maybe<Type>.None }
                    case Some -> {
                        @case-type
                        $ctx.arena $case-type &type.generic-arguments Type:with-generics
                        make Maybe<Type>.Some
                    }
                } @type
                &cases make Checked:MatchCase {
                    $cays.name @name
                    $cays.tag @tag
                    $ctx &cays.body fill-holes-scope @body
                    $type @type
                } Array:push-assert-no-alloc<_>
                $i 1 +
            }
            make Checked:Match {
                $word.token @token
                $type @varint
                $by-ref @by-ref
                $cases @cases
                &word.default match {
                    case None -> { make Maybe<Checked:Scope>.None }
                    case Some -> { .body $ctx flip fill-holes-scope make Maybe<Checked:Scope>.Some }
                } @default
                $ctx &word.parameters fill-holes @parameters
                &word.returns match {
                    case None -> { make Maybe<Array<Type>>.None }
                    case Some -> { $ctx flip fill-holes make Maybe<Array<Type>>.Some }
                } @returns
            } make Checked:Word.Match
        }
        case Unstacked:Word.IndirectCall -> {
            @word
            $ctx $word.function-type fill match {
                case Type.Fun -> {
                    @type
                    make Checked:IndirectCall {
                        $word.token @token
                        make Type:FunType {
                            $word.token @token
                            $type.parameters @parameters
                            $type.returns @returns
                        } @type
                    } make Checked:Word.IndirectCall
                }
                case Type.Closure -> {
                    @type
                    make Checked:ClosureCall {
                        $word.token @token
                        make Type:FunType {
                            $word.token @token
                            $type.parameters @parameters
                            $type.returns @returns
                        } @type
                        $ctx &ctx.function-handle lookup-function-signature .generic-parameters $ctx.arena flip $word.token flip generic-parameters-to-arguments @generic-arguments
                    } make Checked:Word.ClosureCall
                }
                case _ -> { drop Core:unreachable }
            }
        }
        case Unstacked:Word.MakeStructNamed -> {
            @word
            make Checked:MakeStructNamed {
                $word.token @token
                $ctx $word.type fill match {
                    case Type.Custom -> {}
                    case _ -> { drop Core:unreachable<Type:CustomTypeType> }
                } @type
                $ctx &word.body fill-holes-scope @body
            } make Checked:Word.MakeStructNamed
        }
        case Unstacked:Word.FieldInit -> {
            @word
            $ctx $word.type fill match {
                case Type.Custom -> {}
                case _ -> { drop Core:unreachable<Type:CustomTypeType> }
            } @struct-type
            $ctx &struct-type.type-definition lookup-type-definition match {
                case TypeDefinition.Struct -> {}
                case TypeDefinition.Variant -> { drop Core:unreachable<.Resolved:Struct> }
            } @struc
            $ctx.arena
            &struc.fields $word.field-index Array:get<_> .type
            &struct-type.generic-arguments Type:with-generics @field-type
            make Checked:FieldInit {
                $word.name @name
                $field-type @type
                $word.field-index @field-index
            } make Checked:Word.FieldInit
        }
        case Unstacked:Word.FunRef -> {
            @word
            make Checked:Call {
                $word.token @name
                $ctx $word.function fix-function-handle @function
                $ctx &word.generic-arguments fill-holes @generic-arguments
            } make Checked:FunRef make Checked:Word.FunRef
        }
        case Unstacked:Word.GetField -> {
            @word
            $ctx $word.base-type fill match {
                case Type.Ptr -> { drop 1 1 = }
                case _ -> { drop 0 1 = }
            } @on-ptr
            $ctx &word.fields fill-holes-field-accesses @fields
            make Checked:GetField {
                $word.token @token
                $fields @fields
                $on-ptr @on-ptr
                // &fields Array:last<_> .target-type $on-ptr if { make Type.Ptr } else { ~ } @type
            } make Checked:Word.GetField
        }
        case Unstacked:Word.MatchVoid -> { ~ make Checked:Word.MatchVoid }
        case Unstacked:Word.Closure -> {
            @word
            $word.token
            $ctx &word.parameters fill-holes
            $ctx &word.returns fill-holes
            $ctx.function-handle.module $ctx.function-handle.index $word.closure-index + 1 + make FunctionHandle
            $ctx.environment-types $word.closure-index Array:get Maybe:ref Maybe:assert-some ~
            $ctx.arena \LocalId-clone $ctx.closures $word.closure-index Array:get .captured Array:clone-deep
            make Checked:Closure make Checked:Word.Closure
        }
    }
}

fn append-load(arena: .Arena, fields: .FieldAccesses, type: .Type) -> .FieldAccesses {
    $fields loop {
        Core:dup match {
            case FieldAccesses.FieldAccess -> { ~ .next flip drop }
            case FieldAccesses.End -> {
                $type ~ make FieldAccesses.Load store break
            }
            case FieldAccesses.Load -> {
                drop 0 0 / drop drop break
            }
        }
    }
    $fields
}
fn add-environment-path-to-fields(ctx: .Ctx, token: Token, field-access: .Unstacked:ClosureFieldAccess, fields: .FieldAccesses, final-type: .Type) -> FieldAccesses {
    $field-access.next match {
        case NextClosureFieldAccess.Last -> {
            drop
            $ctx.environment-types $field-access.closure-index Array:get Maybe:ref Maybe:assert-some @final-environment-type

            $ctx &final-environment-type.type-definition lookup-type-definition match {
                case TypeDefinition.Struct -> {}
                case TypeDefinition.Variant -> { drop 0 0 / drop Core:unreachable }
            } @final-environment-struct

            &final-environment-struct.fields $field-access.field-index Array:get .type @target-type

            make FieldAccessStep {
                $ctx.arena $fields $final-type ptrify-fields @next
                make Checked:FieldAccess {
                    $token @name // TODO: this is bullshit
                    $final-environment-type ~ make Type.Custom
                    $ctx.arena flip Arena:push make Type.Ptr @source-type
                    $target-type ~ @target-type
                    $field-access.field-index @field-index
                } @access
            }
            $ctx.arena flip Arena:push
            make FieldAccesses.FieldAccess
        }
        case NextClosureFieldAccess.Next -> {
            @next
            make Checked:FieldAccess {
                $token @name // TODO: this is bullshit

                $ctx.environment-types $field-access.closure-index Array:get Maybe:ref Maybe:assert-some ~ make Type.Custom
                $ctx.arena flip Arena:push make Type.Ptr @source-type

                $ctx.environment-types $next.closure-index Array:get Maybe:ref Maybe:assert-some ~ make Type.Custom @target-type
                $field-access.field-index @field-index
            }
            $ctx $token $next $fields $final-type add-environment-path-to-fields
            make FieldAccessStep
            $ctx.arena flip Arena:push
            make FieldAccesses.FieldAccess
        }
    }
}

fn ptrify-fields(arena: .Arena, fields: .Checked:FieldAccesses, result-type: .Type) -> Checked:FieldAccesses {
    $fields match {
        case Checked:FieldAccesses.End -> {
            $result-type ~ make Checked:FieldAccesses.Load
        }
        case Checked:FieldAccesses.Load -> { drop 0 0 / drop Core:unreachable }
        case Checked:FieldAccesses.FieldAccess -> {
            ~ @step
            &step.access @access
            $access.source-type match {
                case Type.Ptr -> {
                    drop
                    $access ~
                    $arena &step.next $result-type ptrify-fields
                    make FieldAccessStep $arena flip Arena:push
                    make Checked:FieldAccesses.FieldAccess
                }
                case Type.Custom -> {
                    drop
                    make Checked:FieldAccess {
                        $access.name @name
                        $arena $access.source-type Arena:push make Type.Ptr @source-type
                        $access.target-type @target-type
                        $access.field-index @field-index
                    }
                    $step.next
                    make FieldAccessStep $arena flip Arena:push
                    make Checked:FieldAccesses.FieldAccess
                }
                case _ -> { drop 0 0 / drop Core:unreachable }
            }
        }
    }
}

fn fill-holes-field-accesses(ctx: .Ctx, field-accesses: .Array<Unstacked:FieldAccess>) -> Checked:FieldAccesses {
    $field-accesses.len 0 = if {
        make Checked:FieldAccesses.End
    } else {
        $ctx $field-accesses 0 Array:get fill-hole-field-access
        $ctx $field-accesses Array:tail & fill-holes-field-accesses
        make Checked:FieldAccessStep
        $ctx.arena flip Arena:push
        make Checked:FieldAccesses.FieldAccess
    }
}

fn fill-hole-field-access(ctx: .Ctx, field-access: .Unstacked:FieldAccess) -> Checked:FieldAccess {
    make Checked:FieldAccess {
        $field-access.name @name
        $ctx $field-access.source-type fill @source-type
        $ctx $field-access.target-type fill @target-type
        &ctx.field-holes $field-access.field-index.index Array:get<_> ~ Maybe:assert-some<_> @field-index
    }
}

fn fill-holes-intrinsic(ctx: .Ctx, intrinsic: .Unstacked:Intrinsic) -> Checked:IntrinsicWord {
    $intrinsic match {
        case Unstacked:Intrinsic.Add -> {
            @intrinsic
            $intrinsic.token
            $ctx $intrinsic.type fill
            make Checked:Intrinsic.Add make Checked:IntrinsicWord
        }
        case Unstacked:Intrinsic.Sub -> {
            @intrinsic
            $intrinsic.token
            $ctx $intrinsic.type fill
            make Checked:Intrinsic.Sub make Checked:IntrinsicWord
        }
        case Unstacked:Intrinsic.Mod -> {
            @intrinsic
            $intrinsic.token
            $ctx $intrinsic.type fill
            make Checked:Intrinsic.Mod make Checked:IntrinsicWord
        }
        case Unstacked:Intrinsic.Mul -> {
            @intrinsic
            $intrinsic.token
            $ctx $intrinsic.type fill
            make Checked:Intrinsic.Mul make Checked:IntrinsicWord
        }
        case Unstacked:Intrinsic.Div -> {
            @intrinsic
            $intrinsic.token
            $ctx $intrinsic.type fill
            make Checked:Intrinsic.Div make Checked:IntrinsicWord
        }
        case Unstacked:Intrinsic.Eq -> {
            @intrinsic
            $intrinsic.token
            $ctx $intrinsic.type fill
            make Checked:Intrinsic.Eq make Checked:IntrinsicWord
        }
        case Unstacked:Intrinsic.NotEq -> {
            @intrinsic
            $intrinsic.token
            $ctx $intrinsic.type fill
            make Checked:Intrinsic.NotEq make Checked:IntrinsicWord
        }
        case Unstacked:Intrinsic.Uninit -> {
            @intrinsic
            $intrinsic.token
            $ctx $intrinsic.type fill
            make Checked:Intrinsic.Uninit make Checked:IntrinsicWord
        }
        case Unstacked:Intrinsic.Drop -> {
            @intrinsic
            $intrinsic.token
            $ctx $intrinsic.type fill
            make Checked:Intrinsic.Drop make Checked:IntrinsicWord
        }
        case Unstacked:Intrinsic.Load -> {
            @intrinsic
            $intrinsic.token
            $ctx $intrinsic.type fill
            make Checked:Intrinsic.Load make Checked:IntrinsicWord
        }
        case Unstacked:Intrinsic.Store -> {
            @intrinsic
            $intrinsic.token
            $ctx $intrinsic.type fill
            make Checked:Intrinsic.Store make Checked:IntrinsicWord
        }
        case Unstacked:Intrinsic.Le -> {
            @intrinsic
            $intrinsic.token
            $ctx $intrinsic.type fill
            make Checked:Intrinsic.Le make Checked:IntrinsicWord
        }
        case Unstacked:Intrinsic.Ge -> {
            @intrinsic
            $intrinsic.token
            $ctx $intrinsic.type fill
            make Checked:Intrinsic.Ge make Checked:IntrinsicWord
        }
        case Unstacked:Intrinsic.Lt -> {
            @intrinsic
            $intrinsic.token
            $ctx $intrinsic.type fill
            make Checked:Intrinsic.Lt make Checked:IntrinsicWord
        }
        case Unstacked:Intrinsic.Gt -> {
            @intrinsic
            $intrinsic.token
            $ctx $intrinsic.type fill
            make Checked:Intrinsic.Gt make Checked:IntrinsicWord
        }
        case Unstacked:Intrinsic.And -> {
            @intrinsic
            $intrinsic.token
            $ctx $intrinsic.type fill
            make Checked:Intrinsic.And make Checked:IntrinsicWord
        }
        case Unstacked:Intrinsic.Or -> {
            @intrinsic
            $intrinsic.token
            $ctx $intrinsic.type fill
            make Checked:Intrinsic.Or make Checked:IntrinsicWord
        }
        case Unstacked:Intrinsic.MemCopy -> {
            ~ make Checked:Intrinsic.MemCopy make Checked:IntrinsicWord
        }
        case Unstacked:Intrinsic.MemFill -> {
            ~ make Checked:Intrinsic.MemFill make Checked:IntrinsicWord
        }
        case Unstacked:Intrinsic.Flip -> {
            @intrinsic
            $intrinsic.token
            $ctx $intrinsic.lower fill
            $ctx $intrinsic.upper fill
            make Checked:Flip make Checked:Intrinsic.Flip make Checked:IntrinsicWord
        }
        case Unstacked:Intrinsic.Shl -> {
            @intrinsic
            $intrinsic.token
            $ctx $intrinsic.type fill make Checked:Intrinsic.Shl make Checked:IntrinsicWord
        }
        case Unstacked:Intrinsic.Shr -> {
            @intrinsic
            $intrinsic.token
            $ctx $intrinsic.type fill make Checked:Intrinsic.Shr make Checked:IntrinsicWord
        }
        case Unstacked:Intrinsic.Rotl -> {
            @intrinsic
            $intrinsic.token
            $ctx $intrinsic.type fill make Checked:Intrinsic.Rotl make Checked:IntrinsicWord
        }
        case Unstacked:Intrinsic.Rotr -> {
            @intrinsic
            $intrinsic.token
            $ctx $intrinsic.type fill make Checked:Intrinsic.Rotr make Checked:IntrinsicWord
        }
        case Unstacked:Intrinsic.MemGrow -> { ~ make Checked:Intrinsic.MemGrow make Checked:IntrinsicWord }
        case Unstacked:Intrinsic.Not -> {
            @intrinsic
            $intrinsic.token
            $ctx $intrinsic.type fill make Checked:Intrinsic.Not make Checked:IntrinsicWord
        }
        case Unstacked:Intrinsic.SetStackSize -> { ~ make Checked:Intrinsic.SetStackSize make Checked:IntrinsicWord }
    }
}

fn fill-holes-locals(ctx: .Ctx, locals: .Map<LocalId, Unstacked:Local>) -> Map<LocalId, Checked:Local> {
    $ctx.arena \LocalId-eq $locals.values.len Map:new-with-capacity<LocalId, Checked:Local> @filled
    loop {
        $filled.values.len $locals.values.len = if { $filled break }
        &filled
        &locals.keys $filled.values.len Array:get<_> @local-id
        &locals.values $filled.values.len Array:get<_> @local

        $local-id ~
        make Checked:Local {
            $local.name @name
            $ctx $local.type fill @type
            &local.parameter match {
                case Some -> { .index ~ make Maybe.Some }
                case None -> { make Maybe.None }
            } @parameter-index
        } Map:insert-assert-no-alloc<_, _> drop
    }
}

fn fill(ctx: .Ctx, hole: InferenceHole) -> Type {
    $ctx $hole lookup-hole match {
        case None -> {
            2 Fmt:to-fd @fmt
            &fmt "\n\nholes: " Fmt:write
            &fmt &ctx.holes Unstacked:Holes-format
            &fmt "\nhole:" Fmt:write
            &fmt &hole Unstacked:InferenceHole-format
            &fmt "\n" Fmt:write
            Core:unreachable<Type>
        }
        case Some -> { ~ }
    }
}

fn fill-holes(ctx: .Ctx, holes: .Array<InferenceHole>) -> Array<Type> {
    $ctx.arena $holes.len Array:new-with-capacity<Type> @filled
    loop {
        $filled.len $holes.len = if { $filled break }
        &filled $ctx $holes $filled.len Array:get<_> ~ fill Array:push-assert-no-alloc<_>
    }
}

fn lookup-holes(ctx: .Ctx, holes: .Array<InferenceHole>) -> Maybe<Array<Type>> {
    $ctx.arena Arena:save @save
    $ctx.arena $holes.len Array:new-with-capacity<Type> @filled
    loop {
        $filled.len $holes.len = if { $filled make Maybe<Array<Type>>.Some break }
        $ctx $holes $filled.len Array:get<_> ~ lookup-hole match {
            case None -> {
                $ctx.arena $save Arena:restore
                make Maybe<Array<Type>>.None break
            }
            case Some -> {}
        } ~ &filled flip Array:push-assert-no-alloc<_>
    }
}

fn lookup-holes-individually(ctx: .Ctx, holes: .Array<InferenceHole>) -> Array<Maybe<Type>> {
    $ctx.arena $holes.len Array:new-with-capacity @filled
    loop {
        $filled.len $holes.len = if { $filled break }
        $ctx $holes $filled.len Array:get ~ lookup-hole match {
            case None -> { make Maybe.None }
            case Some -> { $ctx.arena flip Type:clone make Maybe.Some }
        } &filled flip Array:push-assert-no-alloc<_>
    }
}

fn lookup-origins-individually(ctx: .Ctx, holes: .Array<InferenceHole>) -> Array<Maybe<List<Origin>>> {
    $ctx.arena $holes.len Array:new-with-capacity @filled
    loop {
        $filled.len $holes.len = if { $filled break }
        $ctx $holes $filled.len Array:get ~ lookup-origin match {
            case None -> { make Maybe.None }
            case Some -> { ~ make Maybe.Some }
        } &filled flip Array:push-assert-no-alloc<_>
    }
}

